<local:WszystkieViewBase x:Class="ActiveClubFirma.Views.WszystkieRodzajeCzlonkostwaView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:local="clr-namespace:ActiveClubFirma.Views"
                         mc:Ignorable="d"
                         d:DesignHeight="450"
                         d:DesignWidth="900">

    <Border Background="#2D3E50"
            CornerRadius="8"
            Padding="8">

        <DataGrid ItemsSource="{Binding List}"
                  SelectedItem="{Binding WybranyRodzajCzlonkostwa}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  Background="#2D3E50"
                  Foreground="White"
                  BorderThickness="0"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  AlternationCount="2">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#455A64"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#223040"/>
                    <Setter Property="Padding" Value="8,6"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#223040"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>

                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#2C3E50"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2C3E50"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#455A64"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>

                <DataGridTextColumn Header="Nazwa"
                                    Binding="{Binding Nazwa}"
                                    Width="*"/>

                <DataGridTextColumn Header="Cena"
                                    Binding="{Binding Cena, StringFormat={}{0:0.00}}"
                                    Width="Auto"/>

                <DataGridTextColumn Header="Okres (dni)"
                                    Binding="{Binding OkresDni}"
                                    Width="Auto"/>

                <DataGridCheckBoxColumn Header="Aktywny"
                                        Binding="{Binding CzyAktywny}"
                                        Width="Auto"/>

                <DataGridTextColumn Header="Opis"
                                    Binding="{Binding Opis}"
                                    Width="2*"/>

            </DataGrid.Columns>

        </DataGrid>
    </Border>
</local:WszystkieViewBase>