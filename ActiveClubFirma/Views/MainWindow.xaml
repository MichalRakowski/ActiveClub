<Window x:Class="ActiveClubFirma.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ActiveClubFirma.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="600"
        Width="1000"
        Background="#1E1E1E">

    <!-- ===== DATACONTEXT ===== -->
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <!-- ===== RESOURCES ===== -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MainWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- WIERSZE -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- KOLUMNY -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== MENU BOCZNE ===== -->
        <ScrollViewer Grid.Row="0"
                      Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#2D3E50">

            <StackPanel>
                <!-- LOGO NAD MENU -->
                <StackPanel HorizontalAlignment="Center" Margin="10">
                    <Image Source="/Images/1.png"
                           Width="200"
                           Height="100"
                           HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- UŻYTKOWNICY -->
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="👤 Użytkownicy" Foreground="White"/>
                    </Expander.Header>

                    <ItemsControl ItemsSource="{Binding UzytkownicyCommands}" Margin="24,4,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MenuButtonStyle}"
                                        Content="{Binding DisplayName}"
                                        Command="{Binding Command}"
                                        Margin="0,2,0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- KARNETY -->
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="💳 Karnety i płatności" Foreground="White"/>
                    </Expander.Header>
                    <StackPanel Margin="24,4,0,4">
                        <Button Style="{StaticResource MenuButtonStyle}"
        Content="📋 Wszystkie karnety"
        Command="{Binding RodzajeCzlonkostwaCommands[1].Command}" />
                        <Button Style="{StaticResource MenuButtonStyle}"
        Content="➕ Dodaj karnet"
        Command="{Binding RodzajeCzlonkostwaCommands[0].Command}" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="🏷 Typy karnetów" Command="{Binding ShowTypyKarnetowCommand}" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="🕒 Historia karnetów" Command="{Binding ShowHistoriaKarnetowCommand}" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="💰 Płatności" Command="{Binding ShowPlatnosciCommand}" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="💳 Metody płatności" Command="{Binding ShowMetodyPlatnosciCommand}" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="📊 Raport karnetów" Command="{Binding KarnetyReportCommand}" />
                    </StackPanel>
                </Expander>

                <!-- TRENINGI -->
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="🏋️ Treningi i zajęcia" Foreground="White"/>
                    </Expander.Header>
                    <StackPanel Margin="24,4,0,4">
                        <Button Style="{StaticResource MenuButtonStyle}" Content="📋 Zajęcia" Command="{Binding ShowZajeciaCommand}" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="📆 Harmonogramy zajęć" Command="{Binding ShowHarmonogramyZajecCommand}" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="Zapisy na zajęcia" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="🏃 Plany treningowe" Command="{Binding ShowPlanyTreningoweCommand}" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="🎯 Wyzwania fitness" Command="{Binding ShowWyzwaniaCommand}" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="📈 Postępy użytkowników" Command="{Binding ShowPostepyCommand}" />
                    </StackPanel>
                </Expander>

                <!-- TRENERZY -->
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="👨‍🏫 Trenerzy i kluby" Foreground="White"/>
                    </Expander.Header>

                    <StackPanel Margin="24,4,0,4">
                        <Button Style="{StaticResource MenuButtonStyle}"
                Content="Trenerzy"
                Command="{Binding ShowTrenerzyCommand}" />

                        <Button Style="{StaticResource MenuButtonStyle}"
                Content="Harmonogramy trenerów"
                Command="{Binding ShowHarmonogramyTrenerowCommand}" />

                        <!-- KLUBY (podmenu jak w Użytkownicy/Aktualności) -->
                        <Expander Margin="0,6,0,0">
                            <Expander.Header>
                                <TextBlock Text="Kluby" Foreground="White"/>
                            </Expander.Header>

                            <ItemsControl ItemsSource="{Binding KlubyCommands}" Margin="18,4,0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="{Binding DisplayName}"
                                Command="{Binding Command}"
                                Margin="0,2,0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </Expander>

                <!-- AKTUALNOŚCI -->
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="📰 Aktualności" Foreground="White"/>
                    </Expander.Header>

                    <ItemsControl ItemsSource="{Binding AktualnosciCommands}" Margin="24,4,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MenuButtonStyle}"
                                        Content="{Binding DisplayName}"
                                        Command="{Binding Command}"
                                        Margin="0,2,0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- SPRZĘT -->
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="🛠 Sprzęt" Foreground="White"/>
                    </Expander.Header>
                    <StackPanel Margin="24,4,0,4">
                        <Button Style="{StaticResource MenuButtonStyle}" Content="Sprzęt" Command="{Binding ShowSprzetCommand}" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="Status sprzętu" Command="{Binding ShowStatusSprzetuCommand}" />
                    </StackPanel>
                </Expander>

                <!-- RAPORTY -->
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="📊 Raporty" Foreground="White"/>
                    </Expander.Header>
                    <StackPanel Margin="24,4,0,4">
                        <Button Style="{StaticResource MenuButtonStyle}" Content="📈 Raporty biznesowe" Command="{Binding ShowRaportyCommand}" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="🧾 Szablony raportów" Command="{Binding ShowSzablonyRaportowCommand}" />
                    </StackPanel>
                </Expander>

                <!-- SYSTEM -->
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="⚙ System" Foreground="White"/>
                    </Expander.Header>
                    <StackPanel Margin="24,4,0,4">
                        <Button Style="{StaticResource MenuButtonStyle}" Content="Ustawienia systemowe" Command="{Binding ShowUstawieniaSystemoweCommand}" />
                        <Button Style="{StaticResource MenuButtonStyle}" Content="Logi systemowe" Command="{Binding ShowLogiSystemoweCommand}" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== ZAWARTOŚĆ (WORKSPACES + DASHBOARD) ===== -->
        <Border Grid.Row="0"
                Grid.Column="1"
                Margin="10"
                Background="#1E1E1E"
                CornerRadius="10"
                Padding="16"
                SnapsToDevicePixels="True">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Workspaces -->
                        <RowDefinition Height="Auto"/>
                        <!-- KPI -->
                        <RowDefinition Height="Auto"/>
                        <!-- Reszta -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Workspaces -->
                    <ContentControl Grid.Row="0"
                                    Content="{Binding Workspaces}"
                                    ContentTemplate="{StaticResource WorkspacesTemplate}"
                                    Margin="0,0,0,16"/>

                    <!-- KPI -->
                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                        <!-- Użytkownicy -->
                        <Border Background="#2C5FA8" CornerRadius="8" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Użytkownicy" Foreground="White"/>
                                <TextBlock Text="{Binding UsersCount, StringFormat={}{0}}"
                                           Foreground="White"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Karnety (placeholder) -->
                        <Border Background="#2E7D32" CornerRadius="8" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Karnety" Foreground="White"/>
                                <TextBlock Text="—"
                                           Foreground="White"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Treningi (placeholder) -->
                        <Border Background="#C62828" CornerRadius="8" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Treningi" Foreground="White"/>
                                <TextBlock Text="—"
                                           Foreground="White"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Raporty (placeholder) -->
                        <Border Background="#455A64" CornerRadius="8" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Raporty" Foreground="White"/>
                                <TextBlock Text="—"
                                           Foreground="White"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- ŚRODEK -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Ostatnie działania -->
                            <Border Background="#223040" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Ostatnie działania"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Margin="0,0,0,8"/>
                                    <DataGrid Height="70"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"/>
                                </StackPanel>
                            </Border>

                            <!-- Statystyki sprzedaży -->
                            <Border Grid.Column="1" Background="#223040" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Statystyki sprzedaży"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                    <Border Height="70" Background="#243447" CornerRadius="6" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- DÓŁ -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Najpopularniejsze zajęcia -->
                            <Border Background="#223040" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Najpopularniejsze zajęcia"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <!-- Stan karnetów -->
                            <Border Grid.Column="1" Background="#223040" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Stan karnetów"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ===== STATUS BAR ===== -->
        <StatusBar Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="2">
            <StatusBarItem>
                <TextBlock Text="Michał Rakowski"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="WSB-NLU"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>