<local:JedenViewBase x:Class="ActiveClubFirma.Views.UzytkownicyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ActiveClubFirma.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- Tylko content – toolbar/układ daje JedenViewBase -->
    <Border Background="#2D3E50"
            CornerRadius="8"
            Padding="12">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- IMIĘ -->
            <Label Grid.Column="0" Grid.Row="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Imię"/>

            <TextBox Grid.Column="1" Grid.Row="0"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Imie, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- NAZWISKO -->
            <Label Grid.Column="0" Grid.Row="1"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Nazwisko"/>

            <TextBox Grid.Column="1" Grid.Row="1"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Nazwisko, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- EMAIL -->
            <Label Grid.Column="0" Grid.Row="2"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Email"/>

            <TextBox Grid.Column="1" Grid.Row="2"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- DATA UTWORZENIA -->
            <Label Grid.Column="0" Grid.Row="3"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Data utworzenia"/>

            <TextBox Grid.Column="1" Grid.Row="3"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#1E1E1E"
                     Foreground="White"
                     BorderBrush="#455A64"
                     IsReadOnly="True"
                     Text="{Binding DataUtworzenia, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>

            <!-- TELEFON -->
            <Label Grid.Column="0" Grid.Row="4"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Telefon"/>

            <TextBox Grid.Column="1" Grid.Row="4"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Telefon, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
    </Border>
</local:JedenViewBase>