<local:JedenViewBase x:Class="ActiveClubFirma.Views.KlubyView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="clr-namespace:ActiveClubFirma.Views"
                     mc:Ignorable="d"
                     d:DesignHeight="450" d:DesignWidth="800">

    <!-- Tylko content – toolbar/układ daje JedenViewBase -->
    <Border Background="#2D3E50"
            CornerRadius="8"
            Padding="12">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Nazwa -->
                <RowDefinition Height="Auto"/>
                <!-- Miasto -->
                <RowDefinition Height="Auto"/>
                <!-- Ulica -->
                <RowDefinition Height="Auto"/>
                <!-- Kod -->
                <RowDefinition Height="Auto"/>
                <!-- Telefon -->
                <RowDefinition Height="Auto"/>
                <!-- EmailKontakt -->
                <RowDefinition Height="Auto"/>
                <!-- CzyAktywny -->
                <RowDefinition Height="Auto"/>
                <!-- DataUtworzenia -->
                <RowDefinition Height="Auto"/>
                <!-- Opis -->
            </Grid.RowDefinitions>

            <!-- NAZWA -->
            <Label Grid.Column="0" Grid.Row="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Nazwa"/>

            <TextBox Grid.Column="1" Grid.Row="0"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Nazwa, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- MIASTO -->
            <Label Grid.Column="0" Grid.Row="1"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Miasto"/>

            <TextBox Grid.Column="1" Grid.Row="1"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Miasto, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- ULICA -->
            <Label Grid.Column="0" Grid.Row="2"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Ulica"/>

            <TextBox Grid.Column="1" Grid.Row="2"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Ulica, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- KOD POCZTOWY -->
            <Label Grid.Column="0" Grid.Row="3"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Kod pocztowy"/>

            <TextBox Grid.Column="1" Grid.Row="3"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding KodPocztowy, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- TELEFON -->
            <Label Grid.Column="0" Grid.Row="4"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Telefon"/>

            <TextBox Grid.Column="1" Grid.Row="4"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Telefon, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- EMAIL KONTAKT -->
            <Label Grid.Column="0" Grid.Row="5"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Email kontakt"/>

            <TextBox Grid.Column="1" Grid.Row="5"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding EmailKontakt, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- CZY AKTYWNY -->
            <Label Grid.Column="0" Grid.Row="6"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Czy aktywny"/>

            <CheckBox Grid.Column="1" Grid.Row="6"
                      Margin="0,6,0,6"
                      Foreground="White"
                      IsChecked="{Binding CzyAktywny, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- DATA UTWORZENIA -->
            <Label Grid.Column="0" Grid.Row="7"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Data utworzenia"/>

            <TextBox Grid.Column="1" Grid.Row="7"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#1E1E1E"
                     Foreground="White"
                     BorderBrush="#455A64"
                     IsReadOnly="True"
                     Text="{Binding DataUtworzenia, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>

            <!-- OPIS -->
            <Label Grid.Column="0" Grid.Row="8"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Top"
                   Content="Opis"/>

            <TextBox Grid.Column="1" Grid.Row="8"
                     Margin="0,6,0,0"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Opis, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="120"
                     VerticalScrollBarVisibility="Auto"/>
        </Grid>
    </Border>
</local:JedenViewBase>