<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ActiveClubFirma.ViewModels"
                    xmlns:vw="clr-namespace:ActiveClubFirma.Views"
                    >

    <DataTemplate x:Key="ClosableTabItemTemplate">
        <DockPanel Width="140">
            <Button
            Command="{Binding CloseCommand}"
            Content="X"
            Cursor="Hand"
            DockPanel.Dock="Right"
            Focusable="False"
            FontFamily="Courier"
            FontSize="9"
            FontWeight="Bold"
            Width="16"
            Height="16"
            Margin="4,0,0,0"
            Padding="0" />

            <ContentPresenter
            Content="{Binding DisplayName}"
            VerticalAlignment="Center" />
        </DockPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:NowyUzytkownikViewModel}">
        <vw:UzytkownicyView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:NowaAktualnoscViewModel}">
        <vw:AktualnosciView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:WszyscyUzytkownicyViewModel}">
        <vw:WszyscyUzytkownicyView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:WszystkieAktualnosciViewModel}">
        <vw:WszystkieAktualnosciView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:NowyKlubViewModel}">
        <vw:KlubyView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:WszystkieKlubyViewModel}">
        <vw:WszystkieKlubyView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:NowyRodzajCzlonkostwaViewModel}">
        <vw:RodzajCzlonkostwaView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:WszystkieRodzajeCzlonkostwaViewModel}">
        <vw:WszystkieRodzajeCzlonkostwaView/>
    </DataTemplate>




    <DataTemplate x:Key="WorkspacesTemplate">
        <TabControl
        IsSynchronizedWithCurrentItem="True"
        ItemsSource="{Binding}"
        ItemTemplate="{StaticResource ClosableTabItemTemplate}" />
    </DataTemplate>


    <!-- Kolor tekstu dla głównej zawartości -->
    <SolidColorBrush x:Key="CityFitTextDark" Color="#2D3E50"/>

    <!-- Styl przycisków menu bocznego -->
    <Style x:Key="MenuButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- Efekt hover -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#3E5368"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#1E2B38"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
