<local:WszystkieViewBase x:Class="ActiveClubFirma.Views.WszystkieKlubyView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:local="clr-namespace:ActiveClubFirma.Views"
                         mc:Ignorable="d"
                         d:DesignHeight="450" d:DesignWidth="900">

    <!-- Tylko content – tło/margines/toolbar daje WszystkieViewBase -->
    <Border Background="#2D3E50"
            CornerRadius="8"
            Padding="8">

        <DataGrid ItemsSource="{Binding List}"
                  SelectedItem="{Binding WybranyKlub}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  Background="#2D3E50"
                  Foreground="White"
                  BorderThickness="0"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  AlternationCount="2">

            <!-- Nagłówki -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#455A64"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#223040"/>
                    <Setter Property="Padding" Value="8,6"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <!-- Komórki -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </DataGrid.CellStyle>

            <!-- Wiersze: alternowanie + hover + selected -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#223040"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>

                    <Style.Triggers>
                        <!-- Alternujący wiersz (co drugi) -->
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#2C3E50"/>
                        </Trigger>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2C3E50"/>
                        </Trigger>

                        <!-- Selected -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#455A64"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nazwa"
                                    Binding="{Binding Nazwa}"
                                    Width="*"/>

                <DataGridTextColumn Header="Miasto"
                                    Binding="{Binding Miasto}"
                                    Width="*"/>

                <DataGridTextColumn Header="Ulica"
                                    Binding="{Binding Ulica}"
                                    Width="*"/>

                <DataGridTextColumn Header="Kod pocztowy"
                                    Binding="{Binding KodPocztowy}"
                                    Width="*"/>

                <DataGridTextColumn Header="Telefon"
                                    Binding="{Binding Telefon}"
                                    Width="*"/>

                <DataGridTextColumn Header="Email kontakt"
                                    Binding="{Binding EmailKontakt}"
                                    Width="*"/>

                <DataGridCheckBoxColumn Header="Aktywny"
                                        Binding="{Binding CzyAktywny}"
                                        Width="Auto"/>

                <DataGridTextColumn Header="Data utworzenia"
                                    Binding="{Binding DataUtworzenia, StringFormat=yyyy-MM-dd HH:mm}"
                                    Width="*"/>

                <DataGridTextColumn Header="Opis"
                                    Binding="{Binding Opis}"
                                    Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Border>
</local:WszystkieViewBase>