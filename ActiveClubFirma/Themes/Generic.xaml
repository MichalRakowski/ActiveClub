<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ActiveClubFirma.Views">

    <!-- =========================
         WSPÓLNE STYLE (REUSE)
         ========================= -->

    <!-- Toolbar container -->
    <Style x:Key="ToolbarContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="#2D3E50"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <!-- Filter/sort container -->
    <Style x:Key="FilterContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="#223040"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="0,6,0,6"/>
    </Style>

    <!-- Toolbar itself -->
    <Style x:Key="ToolbarStyle" TargetType="ToolBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Button style used inside ToolBars -->
    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#223040"/>
        <Setter Property="BorderBrush" Value="#455A64"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,2"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2C3E50"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#455A64"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- =========================
         STYLE: WszystkieViewBase
         ========================= -->

    <Style TargetType="{x:Type local:WszystkieViewBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:WszystkieViewBase}">
                    <Grid Background="#1E1E1E" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- TOOLBAR -->
                        <Border Grid.Row="0" Style="{StaticResource ToolbarContainerStyle}">
                            <ToolBar Style="{StaticResource ToolbarStyle}">
                                <Button Style="{StaticResource ToolbarButtonStyle}" Content="Dodaj" Command="{Binding AddCommand}"/>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Content="Edytuj" Command="{Binding EditCommand}"/>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Content="Usuń" Command="{Binding DeleteCommand}"/>
                                <Separator/>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Content="Odśwież" Command="{Binding LoadCommand}"/>
                            </ToolBar>
                        </Border>

                        <!-- SORTOWANIE / FILTROWANIE -->
                        <!--<Border Grid.Row="1" Style="{StaticResource FilterContainerStyle}">
                            <TextBlock Text="Tu będzie sortowanie i filtrowanie"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </Border>-->

                        <!-- CONTENT -->
                        <ContentPresenter Grid.Row="2" Margin="0,5,0,5"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- =========================
         STYLE: WszyscyViewBase
         ========================= -->

    <Style TargetType="{x:Type local:WszyscyViewBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:WszyscyViewBase}">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- TOOLBAR -->
                        <Border Grid.Row="0" Style="{StaticResource ToolbarContainerStyle}">
                            <ToolBar Style="{StaticResource ToolbarStyle}">
                                <Button Style="{StaticResource ToolbarButtonStyle}" Content="Dodaj" Command="{Binding AddCommand}"/>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Content="Edytuj" Command="{Binding EditCommand}"/>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Content="Usuń" Command="{Binding DeleteCommand}"/>
                                <Separator/>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Content="Odśwież" Command="{Binding LoadCommand}"/>
                            </ToolBar>
                        </Border>

                        <!-- SORTOWANIE / FILTROWANIE -->
                        <!--<Border Grid.Row="1" Style="{StaticResource FilterContainerStyle}">
                            <TextBlock Text="Tu będzie sortowanie i filtrowanie"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </Border>-->

                        <!-- CONTENT -->
                        <ContentPresenter Grid.Row="2" Margin="0,5,0,5"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- =========================
         STYLE: JedenViewBase
         ========================= -->

    <Style TargetType="{x:Type local:JedenViewBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:JedenViewBase}">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- TOOLBAR -->
                        <Border Grid.Row="0" Style="{StaticResource ToolbarContainerStyle}">
                            <ToolBar Style="{StaticResource ToolbarStyle}">
                                <Button Style="{StaticResource ToolbarButtonStyle}"
                                        Content="Zapisz i zamknij"
                                        Command="{Binding SaveCommand}"/>

                                <Button Style="{StaticResource ToolbarButtonStyle}"
                                        Content="Anuluj"
                                        Command="{Binding CancelCommand}"/>
                            </ToolBar>
                        </Border>

                        <!-- CONTENT -->
                        <ContentPresenter Grid.Row="1" Margin="0,5,0,5"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>