@{
    ViewData["Title"] = "Multisport";
}

<section class="hero-multisport text-white d-flex align-items-center">
    <div class="container text-center">

        <img src="~/content/2.png.webp"
             alt="Multisport"
             class="multisport-logo mb-4" />

        <h1 class="display-4 fw-bold mb-3">
            Trenuj z kartą Multisport
        </h1>

        <p class="lead mb-4">
            Korzystaj z nowoczesnych klubów ActiveClub
            w ramach programu Multisport.
        </p>

        <a asp-controller="Home"
           asp-action="Kluby"
           class="btn btn-primary btn-lg px-5">
            Znajdź klub
        </a>

    </div>
</section>

<section class="py-5">
    <div class="container">

        <div class="row g-4">

            <div class="col-md-4">
                <div class="multisport-card h-100">
                    <i class="bi bi-lightning-charge fs-1 text-primary"></i>

                    <h4 class="mt-3">
                        Szybkie wejście
                    </h4>

                    <p>
                        Wejdź do klubu bez zbędnych formalności.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="multisport-card h-100">
                    <i class="bi bi-clock-history fs-1 text-primary"></i>

                    <h4 class="mt-3">
                        Dostęp 24/7
                    </h4>

                    <p>
                        Trenuj rano, wieczorem i w weekendy.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="multisport-card h-100">
                    <i class="bi bi-trophy fs-1 text-primary"></i>

                    <h4 class="mt-3">
                        Profesjonalny sprzęt
                    </h4>

                    <p>
                        Strefa cardio, ciężary i trening funkcjonalny.
                    </p>
                </div>
            </div>

        </div>

    </div>
</section>

<section class="bg-light py-5">
    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6 mb-4 mb-lg-0">
                <img src="~/content/multisport-gym.jpg"
                     class="img-fluid rounded-4 shadow"
                     alt="Multisport ActiveClub">
            </div>

            <div class="col-lg-6">

                <h2 class="fw-bold mb-4">
                    Jak skorzystać z karty?
                </h2>

                <div class="mb-3 d-flex">
                    <i class="bi bi-check-circle-fill text-success me-3 fs-4"></i>
                    <div>
                        Pokaż aktywną kartę Multisport przy wejściu.
                    </div>
                </div>

                <div class="mb-3 d-flex">
                    <i class="bi bi-check-circle-fill text-success me-3 fs-4"></i>
                    <div>
                        Zeskanuj wejście w recepcji lub aplikacji.
                    </div>
                </div>

                <div class="mb-3 d-flex">
                    <i class="bi bi-check-circle-fill text-success me-3 fs-4"></i>
                    <div>
                        Korzystaj z klubu bez dodatkowych opłat.
                    </div>
                </div>

            </div>

        </div>

    </div>
</section>