@{
    ViewData["Title"] = "PZU Sport";
}

<section class="hero-pzu text-white d-flex align-items-center">
    <div class="container text-center">

        <img src="~/content/4.webp"
             alt="PZU Sport"
             class="pzu-logo mb-4" />

        <h1 class="display-4 fw-bold mb-3">
            Trenuj z kartą PZU Sport
        </h1>

        <p class="lead mb-4">
            Korzystaj z klubów ActiveClub wygodnie, bez dopłat i wtedy, kiedy chcesz.
        </p>

        <a asp-controller="Home"
           asp-action="Kluby"
           class="btn btn-primary btn-lg px-5">
            Sprawdź kluby
        </a>

    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4">

            <div class="col-md-4">
                <div class="pzu-card h-100">
                    <i class="bi bi-phone fs-1 text-primary"></i>
                    <h4 class="mt-3">Wygodna weryfikacja</h4>
                    <p>Skorzystaj z aktywnego pakietu PZU Sport i rozpocznij trening bez zbędnych formalności.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="pzu-card h-100">
                    <i class="bi bi-clock fs-1 text-primary"></i>
                    <h4 class="mt-3">Trening 24/7</h4>
                    <p>Ćwicz rano, wieczorem albo w weekend — wtedy, kiedy pasuje Ci najbardziej.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="pzu-card h-100">
                    <i class="bi bi-heart-pulse fs-1 text-primary"></i>
                    <h4 class="mt-3">Pełen dostęp</h4>
                    <p>Korzystaj ze stref cardio, siłowych, funkcjonalnych oraz zajęć grupowych.</p>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="bg-light py-5">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6 mb-4 mb-lg-0">
                <img src="~/content/pzu-gym.jpg"
                     class="img-fluid rounded-4 shadow"
                     alt="PZU Sport ActiveClub">
            </div>

            <div class="col-lg-6">
                <h2 class="fw-bold mb-4">Jak skorzystać?</h2>

                <ul class="list-unstyled fs-5">
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                        Przyjdź do wybranego klubu ActiveClub.
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                        Pokaż aktywną kartę PZU Sport lub aplikację.
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                        Rozpocznij trening bez dodatkowych opłat.
                    </li>
                </ul>
            </div>

        </div>
    </div>
</section>