@{
    ViewData["Title"] = "RODO";
}

<section class="rodo-hero">
    <div class="rodo-overlay">
        <div class="container">
            <div class="row align-items-center min-vh-40">
                <div class="col-lg-8">
                    <span class="rodo-badge">ActiveClub</span>

                    <h1>RODO i ochrona danych</h1>

                    <p>
                        Dbamy o bezpieczeństwo Twoich danych osobowych i ich
                        przetwarzanie zgodnie z obowiązującymi przepisami prawa.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="rodo-section py-5">
    <div class="container">

        <div class="rodo-card">
            <h3>Administrator danych</h3>

            <p>
                Administratorem danych osobowych jest ActiveClub.
                Kontakt: kontakt@activeclub.pl
            </p>
        </div>

        <div class="rodo-card">
            <h3>Jakie dane przetwarzamy?</h3>

            <p>
                Możemy przetwarzać dane takie jak:
            </p>

            <ul>
                <li>imię i nazwisko,</li>
                <li>adres e-mail,</li>
                <li>numer telefonu,</li>
                <li>dane związane z członkostwem i płatnościami.</li>
            </ul>
        </div>

        <div class="rodo-card">
            <h3>Cel przetwarzania danych</h3>

            <ul>
                <li>obsługa konta użytkownika,</li>
                <li>zakup i obsługa karnetów,</li>
                <li>rezerwacje zajęć,</li>
                <li>kontakt z klientem,</li>
                <li>realizacja obowiązków prawnych.</li>
            </ul>
        </div>

        <div class="rodo-card">
            <h3>Prawa użytkownika</h3>

            <p>
                Masz prawo do:
            </p>

            <ul>
                <li>wglądu do swoich danych,</li>
                <li>poprawiania danych,</li>
                <li>usunięcia danych,</li>
                <li>ograniczenia przetwarzania,</li>
                <li>wniesienia sprzeciwu.</li>
            </ul>
        </div>

        <div class="rodo-card">
            <h3>Kontakt</h3>

            <p>
                W sprawach związanych z ochroną danych osobowych:
            </p>

            <p>
                <strong>kontakt@activeclub.pl</strong>
            </p>
        </div>

    </div>
</section>