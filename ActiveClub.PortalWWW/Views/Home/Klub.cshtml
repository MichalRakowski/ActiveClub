@model ActiveClub.Shared.DTOs.Kluby.KlubDto

@{
    ViewData["Title"] = Model.Nazwa;
}

<section class="container my-5">

    <a asp-controller="Home" asp-action="Kluby" class="text-decoration-none">
        ← Wróć do listy
    </a>

    <div class="mt-4 p-4 bg-white rounded-4 shadow-sm">

        <h1 class="fw-bold mb-2">@Model.Nazwa</h1>

        <p class="text-muted">
            @Model.Miasto, @Model.Ulica, @Model.KodPocztowy
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.Opis))
        {
            <p style="white-space: pre-line;">@Model.Opis</p>
        }

        <hr />

        <div class="d-flex gap-3 flex-wrap">
            @if (!string.IsNullOrWhiteSpace(Model.Telefon))
            {
                <a href="tel:@Model.Telefon" class="btn btn-outline-secondary">
                    @Model.Telefon
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(Model.EmailKontakt))
            {
                <a href="mailto:@Model.EmailKontakt" class="btn btn-outline-secondary">
                    @Model.EmailKontakt
                </a>
            }
        </div>

    </div>
</section>