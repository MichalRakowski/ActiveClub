@model ActiveClub.PortalWWW.Models.RejestracjaViewModel

@{
    ViewData["Title"] = "Rejestracja";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card shadow-sm p-4">
                <h2 class="mb-4 fw-bold text-center">Załóż konto</h2>

                <form asp-action="Rejestracja" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Imie" class="form-label">Imię</label>
                        <input asp-for="Imie" class="form-control form-control-lg" />
                        <span asp-validation-for="Imie" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Nazwisko" class="form-label">Nazwisko</label>
                        <input asp-for="Nazwisko" class="form-control form-control-lg" />
                        <span asp-validation-for="Nazwisko" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Adres e-mail</label>
                        <input asp-for="Email" class="form-control form-control-lg" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Haslo" class="form-label">Hasło</label>
                        <input asp-for="Haslo" class="form-control form-control-lg" />
                        <span asp-validation-for="Haslo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PowtorzHaslo" class="form-label">Powtórz hasło</label>
                        <input asp-for="PowtorzHaslo" class="form-control form-control-lg" />
                        <span asp-validation-for="PowtorzHaslo" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="AkceptujeRegulamin" class="form-check-input" />
                        <label asp-for="AkceptujeRegulamin" class="form-check-label">
                            Akceptuję regulamin
                        </label>
                        <span asp-validation-for="AkceptujeRegulamin" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-success btn-lg w-100">
                        Zarejestruj się
                    </button>

                    <div class="text-center mt-3">
                        <a asp-action="Logowanie" class="text-decoration-none">
                            Masz już konto? Zaloguj się
                        </a>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
