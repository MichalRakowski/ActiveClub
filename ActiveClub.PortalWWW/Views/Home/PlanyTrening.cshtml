@{
    ViewData["Title"] = "Plany treningowe";
}

<section class="container my-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">Plany treningowe</h1>

        <p class="text-muted">
            Pobierz gotowe plany treningowe przygotowane dla różnych dyscyplin sportowych.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body text-center p-4">

                    <i class="bi bi-activity fs-1 text-primary"></i>

                    <h4 class="fw-bold mt-3">
                        Dla biegacza
                    </h4>

                    <p class="text-muted">
                        Plan treningowy poprawiający wydolność, tempo oraz wytrzymałość biegową.
                    </p>

                    <a href="~/content/plany/ActiveClub_Biegacza.pdf"
                       target="_blank"
                       class="btn btn-primary w-100">
                        Pobierz PDF
                    </a>

                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body text-center p-4">

                    <i class="bi bi-bicycle fs-1 text-primary"></i>

                    <h4 class="fw-bold mt-3">
                        Dla kolarza
                    </h4>

                    <p class="text-muted">
                        Trening poprawiający moc, wytrzymałość oraz przygotowanie do długich tras.
                    </p>

                    <a href="~/content/plany/ActiveClub_Kolarz.pdf"
                       target="_blank"
                       class="btn btn-primary w-100">
                        Pobierz PDF
                    </a>

                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body text-center p-4">

                    <i class="bi bi-snow fs-1 text-primary"></i>

                    <h4 class="fw-bold mt-3">
                        Dla narciarza
                    </h4>

                    <p class="text-muted">
                        Ćwiczenia poprawiające stabilizację, siłę nóg i przygotowanie do sezonu.
                    </p>

                    <a href="~/content/plany/ActiveClub_Narciarz.pdf"
                       target="_blank"
                       class="btn btn-primary w-100">
                        Pobierz PDF
                    </a>

                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body text-center p-4">

                    <i class="bi bi-water fs-1 text-primary"></i>

                    <h4 class="fw-bold mt-3">
                        Dla pływaka
                    </h4>

                    <p class="text-muted">
                        Program poprawiający technikę, wydolność oraz siłę w wodzie.
                    </p>

                    <a href="~/content/plany/ActiveClub_Plywak.pdf"
                       target="_blank"
                       class="btn btn-primary w-100">
                        Pobierz PDF
                    </a>

                </div>
            </div>
        </div>

    </div>

</section>