<!-- TRAINERS -->
<section class="trainer-section my-5" aria-label="Trenerzy personalni">
    <div class="container">

        <h2 class="text-center">
            Wybierz trenera personalnego
        </h2>

        <p class="subtitle text-center text-muted">
            Treningi indywidualne dopasowane do Twoich celów
        </p>

        @if (!trenerzy.Any(x => x.CzyAktywny))
        {
            <div class="alert alert-info text-center mt-4">
                Aktualnie brak dostępnych trenerów.
            </div>
        }
        else
        {
            <div class="trainer-scroll mt-3">

                @foreach (var trener in trenerzy.Where(x => x.CzyAktywny))
                {
                    <div class="trainer-scroll-item">

                        <div class="card h-100 shadow-sm border-0 rounded-4">

                            <div class="card-body d-flex flex-column">

                                <div class="mb-3">
                                    <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">
                                        Trener personalny
                                    </span>
                                </div>

                                <h4 class="fw-bold mb-2">
                                    @trener.Imie @trener.Nazwisko
                                </h4>

                                @if (!string.IsNullOrWhiteSpace(trener.SpecjalizacjaOpis))
                                {
                                    <p class="mb-2">
                                        <strong>Specjalizacja:</strong>
                                        @trener.SpecjalizacjaOpis
                                    </p>
                                }

                                <p class="text-muted flex-grow-1">
                                    @(string.IsNullOrWhiteSpace(trener.Bio)
                                        ? "Trener ActiveClub."
                                        : trener.Bio)
                                </p>

                                <div class="mb-3">
                                    <strong>Stawka:</strong>
                                    @(trener.StawkaZaGodzine?.ToString("0.00") ?? "—")
                                    zł / godz.
                                </div>

                                <a asp-controller="Uzytkownik"
                                   asp-action="UmowTrening"
                                   class="btn btn-primary mt-auto">
                                    Wybierz trenera
                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>
</section>


