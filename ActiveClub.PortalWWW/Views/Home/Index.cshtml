<!-- AKTUALNOŚCI  -->
@if (aktualnosci.Any())
{
    <section class="container my-5" aria-label="Aktualności">
        <div class="d-flex flex-column align-items-center text-center mb-4">
            <h2 class="fw-bold mb-1">Aktualności</h2>
            <p class="text-muted mb-0">Najnowsze informacje i ogłoszenia</p>
        </div>

        <div class="row g-4">
            @foreach (var item in aktualnosci)
            {
                var modalId = $"news_{item.AktualnoscId}";

                <div class="col-lg-4 col-md-6">
                    <article class="card news-card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column">

                            <div class="news-badge mb-3">
                                <i class="bi bi-megaphone"></i>
                                <span>Aktualność</span>
                            </div>

                            <h5 class="news-title">@item.Tytul</h5>

                            <p class="news-text flex-grow-1 mb-0">
                                @Preview(item.Tresc, 220)
                            </p>

                            <div class="d-flex align-items-center justify-content-between mt-3">
                                <span class="text-muted small">
                                    <i class="bi bi-info-circle"></i> Szczegóły
                                </span>

                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#@modalId">
                                    Czytaj więcej
                                </button>
                            </div>

                        </div>
                    </article>
                </div>

                <!-- MODAL: pełna treść -->
                <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title fw-bold">@item.Tytul</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
                            </div>
                            <div class="modal-body">
                                <p class="mb-0" style="white-space: pre-line; line-height: 1.7;">@item.Tresc</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Zamknij</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}