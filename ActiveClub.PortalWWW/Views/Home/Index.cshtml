@using ActiveClub.Shared.DTOs.Aktualnosci
@using ActiveClub.Shared.DTOs.Trenerzy

@{
    ViewData["Title"] = "Home Page";

    var aktualnosci = ViewBag.ModelAktualnosci as List<AktualnoscDto> ?? new List<AktualnoscDto>();
    var trenerzy =
           ViewBag.Trenerzy as List<TrenerDto>
           ?? new List<TrenerDto>();

    string Preview(string? text, int maxLen = 220)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        text = text.Trim();
        if (text.Length <= maxLen) return text;

        var cut = text.Substring(0, maxLen);
        var lastSpace = cut.LastIndexOf(' ');
        if (lastSpace > 80) cut = cut.Substring(0, lastSpace);

        return cut + "…";
    }
   
}


