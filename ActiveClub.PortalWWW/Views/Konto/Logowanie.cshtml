@{
    ViewData["Title"] = "Logowanie";
}



<section class="login-page my-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10">

                <div class="row login-box align-items-stretch">

                    <!-- LEWA -->
                    <div class="col-md-6">
                        <div class="login-col">

                            <h4 class="mb-4 fw-semibold">Zaloguj się przez:</h4>

                            <button type="button" class="btn btn-outline-primary w-100 mb-3 social-btn">
                                <i class="bi bi-facebook me-2"></i> Facebook
                            </button>

                            <button type="button" class="btn btn-outline-danger w-100 mb-3 social-btn">
                                <i class="bi bi-google me-2"></i> Google
                            </button>

                            <button type="button" class="btn btn-outline-info w-100 mb-4 social-btn">
                                <i class="bi bi-linkedin me-2"></i> LinkedIn
                            </button>

                            <div class="mt-auto">
                                <h6 class="fw-semibold">Nie masz konta?</h6>
                                <p class="text-muted small mb-3">
                                    Jeżeli wcześniej nie założyłeś konta, zostaniesz poproszony
                                    o podanie swoich danych.
                                </p>

                                <a asp-controller="Konto" asp-action="Rejestracja"
                                   class="btn btn-primary w-100 login-btn">
                                    Załóż konto
                                </a>
                            </div>

                        </div>
                    </div>

                    <!-- PRAWA -->
                    <div class="col-md-6 divider">
                        <div class="login-col">

                            <h2 class="mb-4 fw-bold">Logowanie</h2>

                            <form asp-controller="Konto" asp-action="Logowanie" method="post" class="d-flex flex-column flex-grow-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                @* komunikat po rejestracji *@
                                @if (TempData["SuccessMessage"] != null)
                                {
                                    <div class="alert alert-success mb-3">
                                        @TempData["SuccessMessage"]
                                    </div>
                                }

                                <div class="mb-3">
                                    <label class="form-label">Adres e-mail</label>
                                    <input name="Email" type="email"
                                           class="form-control form-control-lg"
                                           placeholder="Wprowadź e-mail" autocomplete="email">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Hasło</label>
                                    <input name="Password" type="password"
                                           class="form-control form-control-lg"
                                           placeholder="Wprowadź hasło" autocomplete="current-password">
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="form-check">
                                        <input type="hidden" name="RememberMe" value="false" />
                                        <input name="RememberMe"
                                               type="checkbox"
                                               value="true"
                                               class="form-check-input"
                                               id="rememberMe" />
                                        <label class="form-check-label" for="rememberMe">Zapamiętaj mnie</label>
                                    </div>

                                    <a asp-controller="Konto" asp-action="ZapomnialesHasla" class="small text-decoration-none">
                                        Zapomniałeś hasła?
                                    </a>

                                </div>

                                <button type="submit" class="btn btn-primary login-btn mt-auto w-100">
                                    Zaloguj się
                                </button>

                            </form>

                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</section>
