@{
    ViewData["Title"] = "Potwierdzenie";
}

<section class="confirmation-section py-5">
    <div class="container">

        <div class="confirmation-card text-center">

            <div class="confirmation-icon mb-4">
                <i class="bi bi-check-circle-fill"></i>
            </div>

            <h1 class="fw-bold mb-3">
                Płatność zakończona sukcesem
            </h1>

            @if (TempData["SukcesPlatnosci"] != null)
            {
                <p class="text-muted fs-5 mb-4">
                    @TempData["SukcesPlatnosci"]
                </p>
            }
            else
            {
                <p class="text-muted fs-5 mb-4">
                    Twój karnet został aktywowany.
                </p>
            }

            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-controller="Uzytkownik"
                   asp-action="Index"
                   class="btn btn-primary btn-lg">
                    Przejdź do mojego konta
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-primary btn-lg">
                    Strona główna
                </a>
            </div>

        </div>

    </div>
</section>