@using ActiveClub.Shared.DTOs.Kluby
@model IReadOnlyList<KlubDto>

@{
    ViewData["Title"] = "Kup karnet - wybierz klub";
    var miasta = ViewBag.Miasta as List<string> ?? new();
    var q = Context.Request.Query["q"].ToString();
    var miasto = Context.Request.Query["miasto"].ToString();
}

<section class="container my-5">

    <div class="text-center mb-4">
        <h1 class="fw-bold">Wybierz klub</h1>
        <p class="text-muted">Wybierz lokalizację, w której chcesz realizować karnet</p>
    </div>

    <form method="get" class="card shadow-sm border-0 rounded-4 p-4 mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-lg-6">
                <label class="form-label">Szukaj</label>
                <input name="q"
                       value="@q"
                       class="form-control form-control-lg"
                       placeholder="Nazwa, miasto, ulica, kod..." />
            </div>

            <div class="col-lg-4">
                <label class="form-label">Miasto</label>
                <select name="miasto" class="form-select form-select-lg">
                    <option value="">Wszystkie</option>
                    @foreach (var m in miasta)
                    {
                        if (m == miasto)
                        {
                            <option value="@m" selected>@m</option>
                        }
                        else
                        {
                            <option value="@m">@m</option>
                        }
                    }
                </select>
            </div>

            <div class="col-lg-2 d-grid">
                <button type="submit" class="btn btn-primary btn-lg">
                    Szukaj
                </button>
            </div>
        </div>
    </form>

    @if (Model?.Any() == true)
    {
        <div class="row g-4">
            @foreach (var klub in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 shadow-sm border-0 rounded-4">
                        <div class="card-body d-flex flex-column">

                            <h5 class="fw-bold">@klub.Nazwa</h5>

                            <div class="text-muted mb-2">
                                @klub.Miasto, @klub.Ulica
                            </div>

                            @if (!string.IsNullOrWhiteSpace(klub.KodPocztowy))
                            {
                                <div class="small text-muted mb-2">
                                    @klub.KodPocztowy
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(klub.Opis))
                            {
                                <p class="text-muted">
                                    @(klub.Opis.Length > 140
                                        ? klub.Opis.Substring(0, 140) + "…"
                                        : klub.Opis)
                                </p>
                            }

                            <div class="mt-auto d-flex gap-2">
                                <a asp-controller="Karnety"
                                   asp-action="WybierzKarnet"
                                   asp-route-klubId="@klub.KlubId"
                                   class="btn btn-primary btn-sm">
                                    Wybierz klub
                                </a>

                                <a asp-controller="Home"
                                   asp-action="Klub"
                                   asp-route-id="@klub.KlubId"
                                   class="btn btn-outline-secondary btn-sm">
                                    Szczegóły
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center text-muted py-5">
            Brak klubów spełniających kryteria.
        </div>
    }

</section>