@model ActiveClub.Shared.DTOs.RezerwacjeTrenera.RezerwacjaTreneraDto

@{
    ViewData["Title"] = "Edytuj trening";
}

<section class="container my-5">
    <h1 class="fw-bold mb-4">Edytuj trening personalny</h1>

    <form asp-action="EdytujTrening" method="post" class="card p-4">
        @Html.AntiForgeryToken()

        <input type="hidden" name="rezerwacjaId" value="@Model.RezerwacjaId" />
        <input type="hidden" name="trenerId" value="@Model.TrenerId" />
        <input type="hidden" name="uzytkownikId" value="@Model.UzytkownikId" />
        <input type="hidden" name="klubId" value="@Model.KlubId" />

        <div class="mb-3">
            <label class="form-label">Trener</label>
            <input class="form-control"
                   value="@Model.TrenerNazwa"
                   readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Termin od</label>
            <input type="datetime-local"
                   name="startAt"
                   class="form-control"
                   value="@Model.StartAt.ToString("yyyy-MM-ddTHH:mm")"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Termin do</label>
            <input type="datetime-local"
                   name="endAt"
                   class="form-control"
                   value="@Model.EndAt.ToString("yyyy-MM-ddTHH:mm")"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
                <option value="NOWA" selected="@(Model.Status == "NOWA")">NOWA</option>
                <option value="POTWIERDZONA" selected="@(Model.Status == "POTWIERDZONA")">POTWIERDZONA</option>
                <option value="ANULOWANA" selected="@(Model.Status == "ANULOWANA")">ANULOWANA</option>
                <option value="ZAKONCZONA" selected="@(Model.Status == "ZAKONCZONA")">ZAKONCZONA</option>
            </select>
        </div>

     @*    <div class="mb-3">
            <label class="form-label">Cena</label>
            <input class="form-control"
                   value="@(Model.Cena?.ToString("0.00") ?? "—")"
                   readonly />

            <input type="hidden"
                   name="cena"
                   value="@(Model.Cena?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
        </div> *@

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                Zapisz zmiany
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Anuluj
            </a>
        </div>
    </form>
</section>