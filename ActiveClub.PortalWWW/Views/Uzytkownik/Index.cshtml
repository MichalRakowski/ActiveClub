@model List<ActiveClub.Shared.DTOs.CzlonkostwaUzytkownika.CzlonkostwoUzytkownikaDto>

@{
    ViewData["Title"] = "Moje konto";

    var imie = ViewBag.Imie as string ?? "Użytkownik";
    var nazwisko = ViewBag.Nazwisko as string ?? "";
    var mojeZajecia =
    ViewBag.MojeZajecia as List<ActiveClub.Shared.DTOs.RejestracjeNaZajecia.RejestracjaNaZajeciaDto>
    ?? new();
    var mojeTreningi =
    ViewBag.MojeTreningi as List<ActiveClub.Shared.DTOs.RezerwacjeTrenera.RezerwacjaTreneraDto>
    ?? new();
}

<div class="client-panel">

    <aside class="client-sidebar">
        <div class="client-logo">
            ACTIVE<span>CLUB</span>
        </div>

        <div class="client-user">
            @imie @nazwisko
        </div>

        <nav class="client-menu">
            <a class="menu-item active" href="#lista-karnetow">
                <i class="bi bi-credit-card"></i>
                Karnety i dodatki
            </a>

            <a class="menu-sub active-sub" href="#lista-karnetow">
                Lista karnetów
            </a>

            <a class="menu-item"
               asp-controller="Home"
               asp-action="GrafikZajec">
                <i class="bi bi-calendar-event"></i>
                Zajęcia grupowe
            </a>

            <a class="menu-sub" href="#moje-zajecia">
                Moje zapisane zajęcia
            </a>

            <a class="menu-item" href="#treningi-personalne">
                <i class="bi bi-person-check"></i>
                Treningi personalne
            </a>

            <a class="menu-sub" href="#treningi-personalne">
                Umów trening
            </a>

          

            <a asp-controller="Home"
               asp-action="PlanyTrening"
               class="menu-item">
                <i class="bi bi-trophy"></i>
                Plany treningowe
            </a>

            <a class="menu-item" href="#moje-dane">
                <i class="bi bi-person"></i>
                Moje konto
            </a>

            <a class="menu-sub" href="#moje-dane">
                Moje dane
            </a>

            <a class="menu-sub" href="#faktury">
                Faktury
            </a>
        </nav>

        <div class="sidebar-bottom">
            <a asp-controller="Konto"
               asp-action="Wyloguj"
               class="btn btn-outline-light w-100">
                <i class="bi bi-box-arrow-left me-1"></i>
                Wyloguj się
            </a>
        </div>
    </aside>

    <main class="client-content">

        <header class="client-topbar">
            <a asp-controller="Karnety" asp-action="KupKarnet" class="btn btn-primary">
                Kup karnet
            </a>

            <a href="#moje-dane" class="top-icon text-decoration-none">
                <i class="bi bi-person"></i>
                <small>profil</small>
            </a>

            <button type="button" class="top-icon border-0">
                <i class="bi bi-list"></i>
                <small>menu</small>
            </button>
        </header>

        <section class="content-inner">

            <h1 class="page-title">
                <span></span>
                Moje konto
            </h1>
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }
            <div class="account-section" id="lista-karnetow">
                <div class="section-header">
                    <h5>Lista karnetów</h5>

                    <a asp-controller="Karnety"
                       asp-action="KupKarnet"
                       class="btn btn-primary btn-sm">
                        Kup nowy karnet
                    </a>
                </div>

                @if (Model != null && Model.Any())
                {
                    @foreach (var karnet in Model)
                    {
                        <div class="membership-card">

                            <div class="membership-top">
                                <div>
                                    <div class="membership-name">
                                        @karnet.RodzajCzlonkostwaNazwa
                                    </div>

                                    <div class="membership-club">
                                        @karnet.KlubNazwa
                                    </div>
                                </div>

                                <span class="badge bg-primary">
                                    @(karnet.Status ?? "AKTYWNE")
                                </span>
                            </div>

                            <hr />

                            <div class="membership-info">
                                <div>
                                    <span class="text-muted">Cena</span>
                                    <div class="fw-semibold">
                                        @(karnet.CenaZakupu?.ToString("0.00")) zł
                                    </div>
                                </div>

                                <div>
                                    <span class="text-muted">Aktywny od</span>
                                    <div class="fw-semibold">
                                        @(karnet.StartAt?.ToString("dd.MM.yyyy"))
                                    </div>
                                </div>

                                <div>
                                    <span class="text-muted">Ważny do</span>
                                    <div class="fw-semibold">
                                        @(karnet.EndAt?.ToString("dd.MM.yyyy") ?? "Bezterminowo")
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3 d-flex gap-2 flex-wrap">
                                @if (karnet.Status != "ANULOWANE" && karnet.Status != "ANULOWANY")
                                {
                                    <form asp-controller="Uzytkownik"
                                          asp-action="AnulujKarnet"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="czlonkostwoId"
                                               value="@karnet.CzlonkostwoId" />

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm">
                                            Anuluj karnet
                                        </button>
                                    </form>
                                }

                                <a asp-controller="Karnety"
                                   asp-action="KupKarnet"
                                   class="btn btn-primary btn-sm">
                                    Kup kolejny
                                </a>
                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        Nie masz jeszcze aktywnego karnetu.
                    </div>
                }
            </div>

            <div class="account-section" id="moje-zajecia">
                <div class="section-header">
                    <h5>Moje zapisane zajęcia</h5>

                    <a asp-controller="Home"
                       asp-action="GrafikZajec"
                       class="btn btn-primary btn-sm">
                        Przejdź do grafiku
                    </a>
                </div>

                @if (mojeZajecia.Any())
                {
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Zajęcia</th>
                                    <th>Status</th>
                                    <th>Data zapisu</th>
                                    <th>Akcja</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in mojeZajecia)
                                {
                                    <tr>
                                        <td>@item.HarmonogramNazwa</td>

                                        <td>
                                            @item.Status
                                        </td>

                                        <td>
                                            @(item.DataRejestracji?.ToString("dd.MM.yyyy HH:mm"))
                                        </td>

                                        <td>
                                            @if (item.Status == "ZAPISANY")
                                            {
                                                <form asp-controller="Uzytkownik"
                                                      asp-action="AnulujZapisNaZajecia"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="rejestracjaId"
                                                           value="@item.RejestracjaId" />

                                                    <button type="submit"
                                                            class="btn btn-outline-danger btn-sm">
                                                        Anuluj zapis
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p>Brak zapisanych zajęć.</p>
                }
            </div>

            <div class="account-section" id="treningi-personalne">
                <div class="section-header">
                    <h5>Treningi personalne</h5>

                    <a asp-controller="Uzytkownik"
                       asp-action="UmowTrening"
                       class="btn btn-primary btn-sm">
                        Umów trening
                    </a>
                    @if (mojeTreningi.Any())
                    {
                        <div class="table-responsive mt-3">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Trener</th>
                                        <th>Termin</th>
                                        <th>Status</th>
                                        <th>Cena</th>
                                        <th>Akcja</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in mojeTreningi)
                                    {
                                        <tr>
                                            <td>@item.TrenerNazwa</td>
                                            <td>@item.StartAt.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>@item.Status</td>
                                            <td>@(item.Cena?.ToString("0.00") ?? "—") zł</td>
                                            <td>
                                                <a asp-controller="Uzytkownik"
                                                   asp-action="EdytujTrening"
                                                   asp-route-id="@item.RezerwacjaId"
                                                   class="btn btn-outline-primary btn-sm">
                                                    Edytuj
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="mt-3 mb-0">Brak umówionych treningów.</p>
                    }
                </div>

                <div class="alert alert-light border">
                    <h6 class="mb-2">
                        Chcesz trenować z trenerem?
                    </h6>

                    <p class="mb-3">
                        Wybierz klub, trenera oraz dogodny termin treningu personalnego.
                    </p>

                    <a asp-controller="Uzytkownik"
                       asp-action="UmowTrening"
                       class="btn btn-primary">
                        Wybierz trenera
                    </a>
                </div>
            </div>

            <div class="account-section" id="moje-dane">
                <div class="section-header">
                    <h5>Moje dane</h5>

                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-primary btn-sm" type="button">
                            Zmień hasło
                        </button>

                        <a asp-controller="Uzytkownik"
                           asp-action="Edytuj"
                           class="btn btn-primary btn-sm">
                            Edytuj
                        </a>
                    </div>
                </div>

                <div class="data-row">@imie @nazwisko</div>
                <div class="data-row">
                    @(ViewBag.Email ?? "Brak email")
                </div>

                <div class="data-row">
                    @(ViewBag.Telefon ?? "Brak telefonu")
                </div>
            

           

            <div class="account-section" id="faktury">
                <div class="section-header">
                    <h5>Faktury i transakcje</h5>
                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Karnet</th>
                                    <th>Klub</th>
                                    <th>Kwota</th>
                                    <th>Data</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.OrderByDescending(x => x.DataUtworzenia))
                                {
                                    <tr>
                                        <td>@item.RodzajCzlonkostwaNazwa</td>
                                        <td>@item.KlubNazwa</td>
                                        <td>@(item.CenaZakupu?.ToString("0.00")) zł</td>
                                        <td>@(item.DataUtworzenia?.ToString("dd.MM.yyyy"))</td>
                                        <td>
                                            <span class="badge bg-primary">
                                                @(item.Status ?? "OPŁACONO")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        Brak transakcji.
                    </div>
                }
            </div>

        </section>

    </main>
</div>