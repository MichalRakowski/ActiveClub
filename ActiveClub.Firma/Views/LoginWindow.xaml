<Window x:Class="ActiveClub.Firma.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logowanie"
        Height="360"
        Width="460"
        MinHeight="360"
        MinWidth="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Border Background="#1E1E1E" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="ActiveClub - Logowanie"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Login lub e-mail"
                           Foreground="White"
                           FontSize="13"
                           Margin="0,0,0,6"/>
                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                         Height="38"
                         Padding="10,8"
                         FontSize="14"
                         Background="#2A2A2A"
                         Foreground="White"
                         BorderBrush="#4A4A4A"
                         BorderThickness="1"/>
            </StackPanel>

            <StackPanel Grid.Row="4">
                <TextBlock Text="Hasło"
                           Foreground="White"
                           FontSize="13"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordInput"
                             Height="38"
                             Padding="10,8"
                             FontSize="14"
                             Background="#2A2A2A"
                             Foreground="White"
                             BorderBrush="#4A4A4A"
                             BorderThickness="1"
                             PasswordChanged="PasswordBox_PasswordChanged"/>
                <TextBlock Grid.Row="6"
           Text="{Binding ErrorMessage}"
           Foreground="#FF6B6B"
           FontSize="13"
           TextWrapping="Wrap"
           HorizontalAlignment="Center"
           Margin="0,4,0,0"/>

                <Button Grid.Row="10"
        Content="Zaloguj"
        Command="{Binding LoginCommand}"
        Height="42"
        Width="140"
        HorizontalAlignment="Right"
        Background="#2C5FA8"
        Foreground="White"
        FontWeight="SemiBold"
        BorderThickness="0"
        Cursor="Hand"/>
            </StackPanel>

           

            <Button Grid.Row="10"
                    Content="Zaloguj"
                    Command="{Binding LoginCommand}"
                    Height="42"
                    Width="140"
                    HorizontalAlignment="Right"
                    Background="#2C5FA8"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </Grid>
    </Border>
</Window>