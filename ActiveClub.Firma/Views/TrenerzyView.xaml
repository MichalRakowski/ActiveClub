<local:JedenViewBase x:Class="ActiveClub.Firma.Views.TrenerzyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ActiveClub.Firma.Views"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="#2D3E50"
                CornerRadius="8"
                Padding="12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Grid.Row="0" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Center"
                       Content="Użytkownik"/>

                <Grid Grid.Column="1" Grid.Row="0" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Margin="0,0,8,0"
                             Padding="8,6"
                             Background="#223040"
                             Foreground="White"
                             BorderBrush="#455A64"
                             IsReadOnly="True"
                             Text="{Binding SelectedUzytkownikNazwa}"/>

                    <Button Grid.Column="1"
                            Content="Wybierz użytkownika"
                            Command="{Binding WybierzUzytkownikaCommand}"
                            Padding="8,6"/>
                </Grid>

                <Label Grid.Column="0" Grid.Row="1" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Center"
                       Content="Imię"/>
                <TextBox Grid.Column="1" Grid.Row="1" Margin="0,6,0,6" Padding="8,6"
                         Background="#223040" Foreground="White" BorderBrush="#455A64"
                         IsReadOnly="True"
                         Text="{Binding Imie}"/>

                <Label Grid.Column="0" Grid.Row="2" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Center"
                       Content="Nazwisko"/>
                <TextBox Grid.Column="1" Grid.Row="2" Margin="0,6,0,6" Padding="8,6"
                         Background="#223040" Foreground="White" BorderBrush="#455A64"
                         IsReadOnly="True"
                         Text="{Binding Nazwisko}"/>

                <Label Grid.Column="0" Grid.Row="3" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Center"
                       Content="Email"/>
                <TextBox Grid.Column="1" Grid.Row="3" Margin="0,6,0,6" Padding="8,6"
                         Background="#223040" Foreground="White" BorderBrush="#455A64"
                         IsReadOnly="True"
                         Text="{Binding Email}"/>

                <Label Grid.Column="0" Grid.Row="4" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Center"
                       Content="Telefon"/>
                <TextBox Grid.Column="1" Grid.Row="4" Margin="0,6,0,6" Padding="8,6"
                         Background="#223040" Foreground="White" BorderBrush="#455A64"
                         IsReadOnly="True"
                         Text="{Binding Telefon}"/>

                <Label Grid.Column="0" Grid.Row="5" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Center"
                       Content="Stawka za godzinę"/>
                <TextBox Grid.Column="1" Grid.Row="5" Margin="0,6,0,6" Padding="8,6"
                         Background="#223040" Foreground="White" BorderBrush="#455A64"
                         Text="{Binding StawkaZaGodzine, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Column="0" Grid.Row="6" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Center"
                       Content="Aktywny"/>
                <CheckBox Grid.Column="1" Grid.Row="6" Margin="0,10,0,6"
                          IsChecked="{Binding CzyAktywny}"/>

                <Label Grid.Column="0" Grid.Row="7" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Top"
                       Content="Bio"/>
                <TextBox Grid.Column="1" Grid.Row="7" Margin="0,6,0,6" Padding="8,6"
                         Height="90"
                         Background="#223040" Foreground="White" BorderBrush="#455A64"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Text="{Binding Bio, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Column="0" Grid.Row="8" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Top"
                       Content="Specjalizacja"/>
                <TextBox Grid.Column="1" Grid.Row="8" Margin="0,6,0,6" Padding="8,6"
                         Height="90"
                         Background="#223040" Foreground="White" BorderBrush="#455A64"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Text="{Binding SpecjalizacjaOpis, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Grid.Column="1"
                            Grid.Row="9"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">

                   
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</local:JedenViewBase>