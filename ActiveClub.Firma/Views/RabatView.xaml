<local:JedenViewBase x:Class="ActiveClub.Firma.Views.RabatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ActiveClub.Firma.Views"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="850">

    <Border Background="#2D3E50"
            CornerRadius="8"
            Padding="12">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Kod"/>
            <TextBox Grid.Column="1" Grid.Row="0" Margin="0,6,0,6" Padding="8,6"
                     Background="#223040" Foreground="White" BorderBrush="#455A64"
                     Text="{Binding Kod, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="1" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Typ"/>
            <TextBox Grid.Column="1" Grid.Row="1" Margin="0,6,0,6" Padding="8,6"
                     Background="#223040" Foreground="White" BorderBrush="#455A64"
                     Text="{Binding Typ, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="2" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Wartość"/>
            <TextBox Grid.Column="1" Grid.Row="2" Margin="0,6,0,6" Padding="8,6"
                     Background="#223040" Foreground="White" BorderBrush="#455A64"
                     Text="{Binding Wartosc, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="3" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Data od"/>
            <DatePicker Grid.Column="1" Grid.Row="3"
                        Margin="0,6,0,6"
                        SelectedDate="{Binding DataOdView, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="4" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Data do"/>
            <DatePicker Grid.Column="1" Grid.Row="4"
                        Margin="0,6,0,6"
                        SelectedDate="{Binding DataDoView, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="5" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Minimalna kwota zamówienia"/>
            <TextBox Grid.Column="1" Grid.Row="5" Margin="0,6,0,6" Padding="8,6"
                     Background="#223040" Foreground="White" BorderBrush="#455A64"
                     Text="{Binding MinimalnaKwotaZamowienia, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="6" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Maks. liczba użyć"/>
            <TextBox Grid.Column="1" Grid.Row="6" Margin="0,6,0,6" Padding="8,6"
                     Background="#223040" Foreground="White" BorderBrush="#455A64"
                     Text="{Binding MaksLiczbaUzyc, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="7" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Aktywny"/>
            <CheckBox Grid.Column="1" Grid.Row="7" Margin="0,10,0,6"
                      IsChecked="{Binding CzyAktywny}"/>
        </Grid>
    </Border>
</local:JedenViewBase>