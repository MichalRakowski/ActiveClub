<Window x:Class="ActiveClub.Firma.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ActiveClub.Firma.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="600"
        Width="1000"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MainWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- WIERSZE -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- KOLUMNY -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== MENU BOCZNE ===== -->
        <ScrollViewer Grid.Row="0"
                      Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#2D3E50">

            <StackPanel Margin="0,0,0,8">

                <!-- LOGO -->
                <StackPanel HorizontalAlignment="Center" Margin="10">
                    <Image Source="/Images/1.png"
                           Width="200"
                           Height="100"
                           HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- do usuniuecia -->

                <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="5">

                    <!--<Button Content="ADMIN"
            Command="{Binding SetAdminRoleCommand}"
            Margin="3"/>

                    <Button Content="PRACOWNIK"
            Command="{Binding SetPracownikRoleCommand}"
            Margin="3"/>

                    <Button Content="TRENER"
            Command="{Binding SetTrenerRoleCommand}"
            Margin="3"/>-->

                   
                </StackPanel>

                <!-- UŻYTKOWNICY -->
                <Expander IsExpanded="True" Margin="6,4">
                    <Expander.Style>
                        <Style TargetType="Expander">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanSeeUsers}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <Expander.Header>
                        <TextBlock Text="👤 Użytkownicy"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>
                    </Expander.Header>

                    <StackPanel Margin="16,6,0,6">
                        <ItemsControl ItemsSource="{Binding UzytkownicyCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MenuButtonStyle}"
                                            Content="{Binding DisplayName}"
                                            Command="{Binding Command}"
                                            Margin="0,2,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- CZŁONKOSTWA I SPRZEDAŻ -->
                <Expander Margin="6,4">
                    <Expander.Style>
                        <Style TargetType="Expander">
                            <Setter Property="Visibility" Value="Visible"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanSeeSales}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <Expander.Header>
                        <TextBlock Text="💳 Członkostwa i sprzedaż"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>
                    </Expander.Header>

                    <StackPanel Margin="16,6,0,6">
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="➕ Dodaj karnet"
                                Command="{Binding RodzajeCzlonkostwaCommands[0].Command}" />
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="📋 Wszystkie karnety"
                                Command="{Binding RodzajeCzlonkostwaCommands[1].Command}" />

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="➕ Dodaj ofertę członkostwa"
                                Command="{Binding OfertyKlubuCzlonkostwaCommands[0].Command}" />
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="📋 Wszystkie oferty członkostwa"
                                Command="{Binding OfertyKlubuCzlonkostwaCommands[1].Command}" />

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="➕ Dodaj członkostwo"
                                Command="{Binding CzlonkostwaCommands[0].Command}" />
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="📋 Wszystkie członkostwa"
                                Command="{Binding CzlonkostwaCommands[1].Command}" />

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="➕ Dodaj płatność"
                                Command="{Binding PlatnosciCommands[0].Command}" />
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="📋 Wszystkie płatności"
                                Command="{Binding PlatnosciCommands[1].Command}" />

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="➕ Dodaj zamówienie"
                                Command="{Binding ZamowieniaCommands[0].Command}" />
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="📋 Wszystkie zamówienia"
                                Command="{Binding ZamowieniaCommands[1].Command}" />

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="➕ Dodaj pozycję zamówienia"
                                Command="{Binding PozycjeZamowieniaCommands[0].Command}" />
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="📋 Wszystkie pozycje zamówienia"
                                Command="{Binding PozycjeZamowieniaCommands[1].Command}" />
                    </StackPanel>
                </Expander>

                <!-- ZAJĘCIA I REZERWACJE -->
                <Expander Margin="6,4">
                    <Expander.Style>
                        <Style TargetType="Expander">
                            <Setter Property="Visibility" Value="Visible"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanSeeClasses}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <Expander.Header>
                        <TextBlock Text="🏋️ Zajęcia i rezerwacje"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>
                    </Expander.Header>

                    <StackPanel Margin="16,6,0,6">
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="➕ Dodaj salę"
                                Command="{Binding SaleCommands[0].Command}" />
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="📋 Wszystkie sale"
                                Command="{Binding SaleCommands[1].Command}" />

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="➕ Dodaj rodzaj zajęć"
                                Command="{Binding RodzajeZajecCommands[0].Command}" />
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="📋 Wszystkie rodzaje zajęć"
                                Command="{Binding RodzajeZajecCommands[1].Command}" />

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="➕ Dodaj harmonogram zajęć"
                                Command="{Binding HarmonogramZajecCommands[0].Command}" />
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="📋 Wszystkie harmonogramy zajęć"
                                Command="{Binding HarmonogramZajecCommands[1].Command}" />

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="➕ Dodaj rezerwację"
                                Command="{Binding RejestracjeNaZajeciaCommands[0].Command}" />
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="📋 Wszystkie rezerwacje"
                                Command="{Binding RejestracjeNaZajeciaCommands[1].Command}" />

                        <ItemsControl ItemsSource="{Binding RezerwacjeTreneraCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MenuButtonStyle}"
                                            Content="{Binding DisplayName}"
                                            Command="{Binding Command}"
                                            Margin="0,2,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding DostepnoscTreneraCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MenuButtonStyle}"
                                            Content="{Binding DisplayName}"
                                            Command="{Binding Command}"
                                            Margin="0,2,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- KADRA I KLUBY -->
                <Expander Margin="6,4">
                    <Expander.Style>
                        <Style TargetType="Expander">
                            <Setter Property="Visibility" Value="Visible"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanSeeStaff}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <Expander.Header>
                        <TextBlock Text="👨‍🏫 Kadra i kluby"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>
                    </Expander.Header>

                    <StackPanel Margin="16,6,0,6">
                        <ItemsControl ItemsSource="{Binding TrenerzyCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MenuButtonStyle}"
                                            Content="{Binding DisplayName}"
                                            Command="{Binding Command}"
                                            Margin="0,2,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding KlubyCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MenuButtonStyle}"
                                            Content="{Binding DisplayName}"
                                            Command="{Binding Command}"
                                            Margin="0,2,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="➕ Dodaj pracownika klubu"
                                Command="{Binding PracownicyKlubuCommands[0].Command}" />
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="📋 Wszyscy pracownicy klubu"
                                Command="{Binding PracownicyKlubuCommands[1].Command}" />

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="➕ Dodaj stanowisko"
                                Command="{Binding StanowiskaCommands[0].Command}" />
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="📋 Wszystkie stanowiska"
                                Command="{Binding StanowiskaCommands[1].Command}" />

                        <ItemsControl ItemsSource="{Binding GodzinyOtwarciaCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MenuButtonStyle}"
                                            Content="{Binding DisplayName}"
                                            Command="{Binding Command}"
                                            Margin="0,2,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- SŁOWNIKI I KONFIGURACJA -->
                <Expander Margin="6,4">
                    <Expander.Style>
                        <Style TargetType="Expander">
                            <Setter Property="Visibility" Value="Visible"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanSeeConfig}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <Expander.Header>
                        <TextBlock Text="⚙️ Słowniki i konfiguracja"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>
                    </Expander.Header>

                    <StackPanel Margin="16,6,0,6">
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="➕ Dodaj metodę płatności"
                                Command="{Binding MetodyPlatnosciCommands[0].Command}" />

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="📋 Wszystkie metody płatności"
                                Command="{Binding MetodyPlatnosciCommands[1].Command}" />

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="➕ Dodaj rabat"
                                Command="{Binding RabatyCommands[0].Command}" />

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="📋 Wszystkie rabaty"
                                Command="{Binding RabatyCommands[1].Command}" />
                        <Button Style="{StaticResource MenuButtonStyle}"
        Content="⚙️ Dane kontaktowe"
        Command="{Binding UstawieniaKontaktoweCommands[0].Command}" />
                    </StackPanel>
                </Expander>

                <!-- TREŚCI I OPINIE -->
                <Expander Margin="6,4">
                    <Expander.Style>
                        <Style TargetType="Expander">
                            <Setter Property="Visibility" Value="Visible"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanSeeContent}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <Expander.Header>
                        <TextBlock Text="📰 Treści i opinie"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>
                    </Expander.Header>

                    <StackPanel Margin="16,6,0,6">
                        <ItemsControl ItemsSource="{Binding AktualnosciCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MenuButtonStyle}"
                                            Content="{Binding DisplayName}"
                                            Command="{Binding Command}"
                                            Margin="0,2,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="📋 Wszystkie opinie"
                                Command="{Binding OpinieCommands[0].Command}" />
                    </StackPanel>
                </Expander>

                <!-- RAPORTY -->
                <Expander Margin="6,4">
                    <Expander.Style>
                        <Style TargetType="Expander">
                            <Setter Property="Visibility" Value="Visible"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanSeeReports}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <Expander.Header>
                        <TextBlock Text="📊 Raporty"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>
                    </Expander.Header>

                    <StackPanel Margin="16,6,0,6">
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="➕ Generuj raport"
                                Command="{Binding RaportyCommands[0].Command}" />

                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="📋 Wszystkie raporty"
                                Command="{Binding RaportyCommands[1].Command}" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== PRAWA STRONA ===== -->
        <Border Grid.Row="0"
                Grid.Column="1"
                Margin="10"
                Background="#1E1E1E"
                CornerRadius="10"
                Padding="16"
                SnapsToDevicePixels="True">

            <Grid HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

                <!-- DASHBOARD -->
                <Grid HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDashboardVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- KPI -->
                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
                        <Border Background="#2C5FA8" CornerRadius="8" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Aktywni użytkownicy" Foreground="White"/>
                                <TextBlock Text="{Binding ActiveUsersCount}"
                                           Foreground="White"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#2E7D32" CornerRadius="8" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Aktywne karnety" Foreground="White"/>
                                <TextBlock Text="{Binding ActiveSoldMembershipsCount}"
                                           Foreground="White"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#C62828" CornerRadius="8" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Aktywni trenerzy" Foreground="White"/>
                                <TextBlock Text="{Binding ActiveTrainersCount}"
                                           Foreground="White"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#455A64" CornerRadius="8" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Aktywne kluby" Foreground="White"/>
                                <TextBlock Text="{Binding ActiveClubsCount}"
                                           Foreground="White"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- DOLNA CZĘŚĆ DASHBOARDU -->
                    <Grid Grid.Row="1" Margin="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="#223040" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Ostatnia opinia użytkownika"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Margin="0,0,0,8"/>

                                    <TextBlock Text="{Binding LastOpinionAuthor}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,4"/>

                                    <TextBlock Text="{Binding LastOpinionContent}"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               MaxHeight="70"/>

                                    <TextBlock Text="{Binding LastOpinionDate}"
                                               Foreground="#B0BEC5"
                                               FontSize="11"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="#223040"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Ostatnia aktualność"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Margin="0,0,0,8"/>

                                    <Border Background="#243447"
                                            CornerRadius="6"
                                            Padding="10"
                                            Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding LastNewsTitle}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,4"/>

                                            <TextBlock Text="{Binding LastNewsContent}"
                                                       Foreground="White"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="60"/>

                                            <TextBlock Text="{Binding LastNewsDate}"
                                                       Foreground="#B0BEC5"
                                                       FontSize="11"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="#223040" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Ostatnio dodane zajęcia"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Margin="0,0,0,8"/>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  MaxHeight="220">
                                        <ItemsControl ItemsSource="{Binding OstatnioDodaneRodzajeZajec}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#243447"
                                                            CornerRadius="6"
                                                            Padding="10"
                                                            Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Nazwa}"
                                                                       Foreground="White"
                                                                       FontWeight="SemiBold"/>

                                                            <TextBlock Text="{Binding Opis}"
                                                                       Foreground="#CFD8DC"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,4,0,0"/>

                                                            <TextBlock Text="{Binding RodzajZajecId, StringFormat=ID: {0}}"
                                                                       Foreground="#B0BEC5"
                                                                       FontSize="11"
                                                                       Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="#223040"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Ostatnio dodani pracownicy"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Margin="0,0,0,8"/>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  MaxHeight="220">
                                        <ItemsControl ItemsSource="{Binding OstatnioDodaniPracownicyKlubu}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#243447"
                                                            CornerRadius="6"
                                                            Padding="10"
                                                            Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding UzytkownikNazwa}"
                                                                       Foreground="White"
                                                                       FontWeight="SemiBold"/>

                                                            <TextBlock Text="{Binding KlubNazwa}"
                                                                       Foreground="#CFD8DC"
                                                                       Margin="0,4,0,0"/>

                                                            <TextBlock Text="{Binding StanowiskoNazwa}"
                                                                       Foreground="#B0BEC5"
                                                                       FontSize="11"
                                                                       Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- WORKSPACES -->
                <ContentControl Content="{Binding Workspaces}"
                                ContentTemplate="{StaticResource WorkspacesTemplate}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWorkspaceVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

            </Grid>
        </Border>

        <!-- ===== STATUS BAR ===== -->
        <StatusBar Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="2">
            <StatusBarItem>
                <TextBlock Text="Michał Rakowski"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="WSB-NLU"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>