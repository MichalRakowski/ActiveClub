<local:JedenViewBase x:Class="ActiveClub.Firma.Views.PozycjaZamowieniaView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="clr-namespace:ActiveClub.Firma.Views"
                     mc:Ignorable="d"
                     d:DesignHeight="620"
                     d:DesignWidth="900">

    <Border Background="#2D3E50" CornerRadius="8" Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Zamówienie"/>
            <ComboBox Grid.Column="1"
                      Grid.Row="0"
                      Margin="0,6,0,6"
                      Padding="8,6"
                      Background="#223040"
                      Foreground="Black"
                      BorderBrush="#455A64"
                      ItemsSource="{Binding Zamowienia}"
                      DisplayMemberPath="Nazwa"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding ZamowienieId, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="1" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Typ"/>
            <ComboBox Grid.Column="1"
                      Grid.Row="1"
                      Margin="0,6,0,6"
                      Padding="8,6"
                      Background="#223040"
                      Foreground="Black"
                      BorderBrush="#455A64"
                      ItemsSource="{Binding Typy}"
                      DisplayMemberPath="Nazwa"
                      SelectedValuePath="Nazwa"
                      SelectedValue="{Binding Typ, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="2" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="RefId"/>
            <TextBox Grid.Column="1"
                     Grid.Row="2"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding RefId, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="3" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Nazwa"/>
            <TextBox Grid.Column="1"
                     Grid.Row="3"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Nazwa, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="4" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Top" Content="Opis"/>
            <TextBox Grid.Column="1"
                     Grid.Row="4"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Opis, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="90"/>

            <Label Grid.Column="0" Grid.Row="5" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Ilość"/>
            <TextBox Grid.Column="1"
                     Grid.Row="5"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Ilosc, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="6" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Cena jedn."/>
            <TextBox Grid.Column="1"
                     Grid.Row="6"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding CenaJedn, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="7" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Kwota brutto"/>
            <TextBox Grid.Column="1"
                     Grid.Row="7"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding KwotaBrutto, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
    </Border>
</local:JedenViewBase>