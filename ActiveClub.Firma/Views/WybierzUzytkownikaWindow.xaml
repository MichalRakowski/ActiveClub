<Window x:Class="ActiveClub.Firma.Views.WybierzUzytkownikaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wybierz użytkownika"
        Height="450"
        Width="750"
        WindowStartupLocation="CenterOwner"
        Background="#2D3E50">

    <DockPanel Margin="12">

        <TextBox DockPanel.Dock="Top"
                 Margin="0,0,0,10"
                 Padding="8,6"
                 Background="#223040"
                 Foreground="White"
                 BorderBrush="#455A64"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <Button Content="Anuluj"
                    Width="100"
                    Margin="0,0,8,0"
                    IsCancel="True" />

            <Button Content="Wybierz"
                    Width="100"
                    IsDefault="True"
                    Command="{Binding SelectCommand}" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding FilteredUsers}"
                  SelectedItem="{Binding SelectedUser}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Imię" Binding="{Binding Imie}" Width="*" />
                <DataGridTextColumn Header="Nazwisko" Binding="{Binding Nazwisko}" Width="*" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" />
                <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}" Width="*" />
                <DataGridTextColumn Header="Rola" Binding="{Binding Rola}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>