<local:JedenViewBase x:Class="ActiveClub.Firma.Views.RezerwacjeTreneraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ActiveClub.Firma.Views"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="850">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="#2D3E50"
                CornerRadius="8"
                Padding="12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0"
                       Margin="0,6,12,6"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Content="Trener"/>

                <Grid Grid.Row="0" Grid.Column="1" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Margin="0,0,8,0"
                             Padding="8,6"
                             Background="#223040"
                             Foreground="White"
                             BorderBrush="#455A64"
                             IsReadOnly="True"
                             Text="{Binding SelectedTrenerNazwa, Mode=OneWay}"/>

                    <Button Grid.Column="1"
                            Content="Wybierz trenera"
                            Command="{Binding WybierzTreneraCommand}"
                            Padding="8,6"/>
                </Grid>

                <Label Grid.Row="1" Grid.Column="0"
                       Margin="0,6,12,6"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Content="Klub"/>

                <Grid Grid.Row="1" Grid.Column="1" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Margin="0,0,8,0"
                             Padding="8,6"
                             Background="#223040"
                             Foreground="White"
                             BorderBrush="#455A64"
                             IsReadOnly="True"
                             Text="{Binding SelectedKlubNazwa, Mode=OneWay}"/>

                    <Button Grid.Column="1"
                            Content="Wybierz klub"
                            Command="{Binding WybierzKlubCommand}"
                            Padding="8,6"/>
                </Grid>

                <Label Grid.Row="2" Grid.Column="0"
                       Margin="0,6,12,6"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Content="Użytkownik"/>

                <Grid Grid.Row="2" Grid.Column="1" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Margin="0,0,8,0"
                             Padding="8,6"
                             Background="#223040"
                             Foreground="White"
                             BorderBrush="#455A64"
                             IsReadOnly="True"
                             Text="{Binding SelectedUzytkownikNazwa, Mode=OneWay}"/>

                    <Button Grid.Column="1"
                            Content="Wybierz użytkownika"
                            Command="{Binding WybierzUzytkownikaCommand}"
                            Padding="8,6"/>
                </Grid>

                <Label Grid.Row="3" Grid.Column="0"
                       Margin="0,6,12,6"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Content="Data"/>

                <DatePicker Grid.Row="3" Grid.Column="1"
                            Margin="0,6,0,6"
                            SelectedDate="{Binding DataRezerwacji, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="4" Grid.Column="0"
                       Margin="0,6,12,6"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Content="Godzina od"/>

                <TextBox Grid.Row="4" Grid.Column="1"
                         Margin="0,6,0,6"
                         Padding="8,6"
                         Background="#223040"
                         Foreground="White"
                         BorderBrush="#455A64"
                         Text="{Binding GodzinaOd, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="5" Grid.Column="0"
                       Margin="0,6,12,6"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Content="Godzina do"/>

                <TextBox Grid.Row="5" Grid.Column="1"
                         Margin="0,6,0,6"
                         Padding="8,6"
                         Background="#223040"
                         Foreground="White"
                         BorderBrush="#455A64"
                         Text="{Binding GodzinaDo, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="6" Grid.Column="0"
                       Margin="0,6,12,6"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Content="Harmonogram"/>

                <Grid Grid.Row="6" Grid.Column="1" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Margin="0,0,8,0"
                             Padding="8,6"
                             Background="#223040"
                             Foreground="White"
                             BorderBrush="#455A64"
                             IsReadOnly="True"
                             Text="{Binding HarmonogramOpis, Mode=OneWay}"/>

                    <Button Grid.Column="1"
                            Content="Edytuj harmonogram"
                            Command="{Binding EdytujHarmonogramCommand}"
                            Padding="8,6"/>
                </Grid>

                <Label Grid.Row="7" Grid.Column="0"
                       Margin="0,6,12,6"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Content="Status"/>

                <ComboBox Grid.Row="7" Grid.Column="1"
                          Margin="0,6,0,6"
                          Padding="8,6"
                          Background="#223040"
                          Foreground="Black"
                          BorderBrush="#455A64"
                          ItemsSource="{Binding Statusy}"
                          SelectedItem="{Binding SelectedStatus, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="8" Grid.Column="0"
                       Margin="0,6,12,6"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Content="Cena"/>

                <TextBox Grid.Row="8" Grid.Column="1"
                         Margin="0,6,0,6"
                         Padding="8,6"
                         Background="#223040"
                         Foreground="White"
                         BorderBrush="#455A64"
                         Text="{Binding Cena, UpdateSourceTrigger=PropertyChanged}"/>

            </Grid>
        </Border>
    </ScrollViewer>
</local:JedenViewBase>