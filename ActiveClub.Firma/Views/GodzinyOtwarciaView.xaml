<local:JedenViewBase x:Class="ActiveClub.Firma.Views.GodzinyOtwarciaView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="clr-namespace:ActiveClub.Firma.Views"
                     mc:Ignorable="d"
                     d:DesignHeight="620" d:DesignWidth="850">

    <Border Background="#2D3E50" CornerRadius="8" Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   Content="Klub"/>

            <Grid Grid.Row="0" Grid.Column="1" Margin="0,6,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Margin="0,0,8,0"
                         Padding="8,6"
                         Background="#223040"
                         Foreground="White"
                         BorderBrush="#455A64"
                         IsReadOnly="True"
                         Text="{Binding SelectedKlubNazwa, Mode=OneWay}"/>

                <Button Grid.Column="1"
                        Content="Wybierz klub"
                        Command="{Binding WybierzKlubCommand}"
                        Padding="8,6"/>
            </Grid>

            <Label Grid.Row="1" Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   Content="Dni tygodnia"/>

            <ItemsControl Grid.Row="1" Grid.Column="1"
                          Margin="0,6,0,6"
                          ItemsSource="{Binding DniTygodnia}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Nazwa}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Foreground="White"
                                  Margin="0,0,16,6"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Label Grid.Row="2" Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   Content="Godzina od"/>

            <TextBox Grid.Row="2" Grid.Column="1"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding GodzinaOdText, UpdateSourceTrigger=LostFocus}"/>

            <Label Grid.Row="3" Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   Content="Godzina do"/>

            <TextBox Grid.Row="3" Grid.Column="1"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding GodzinaDoText, UpdateSourceTrigger=LostFocus}"/>

            <Label Grid.Row="4" Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   Content="Zamknięte"/>

            <CheckBox Grid.Row="4" Grid.Column="1"
                      Margin="0,10,0,6"
                      Foreground="White"
                      IsChecked="{Binding CzyZamkniete, UpdateSourceTrigger=PropertyChanged}"/>

            
        </Grid>
    </Border>
</local:JedenViewBase>