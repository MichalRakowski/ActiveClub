<local:JedenViewBase x:Class="ActiveClub.Firma.Views.PracownikKlubuView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="clr-namespace:ActiveClub.Firma.Views"
                     mc:Ignorable="d"
                     d:DesignHeight="560"
                     d:DesignWidth="850">

    <Border Background="#2D3E50" CornerRadius="8" Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Użytkownik"/>
            <Grid Grid.Column="1" Grid.Row="0" Margin="0,6,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
             Margin="0,0,8,0"
             Padding="8,6"
             Background="#223040"
             Foreground="White"
             BorderBrush="#455A64"
             IsReadOnly="True"
             Text="{Binding SelectedUzytkownikNazwa, Mode=OneWay}"/>

                <Button Grid.Column="1"
            Content="Wybierz użytkownika"
            Command="{Binding WybierzUzytkownikaCommand}"
            Padding="8,6"/>
            </Grid>

            <Label Grid.Column="0" Grid.Row="1" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Klub"/>
            <Grid Grid.Column="1" Grid.Row="1" Margin="0,6,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
             Margin="0,0,8,0"
             Padding="8,6"
             Background="#223040"
             Foreground="White"
             BorderBrush="#455A64"
             IsReadOnly="True"
             Text="{Binding SelectedKlubNazwa, Mode=OneWay}"/>

                <Button Grid.Column="1"
            Content="Wybierz klub"
            Command="{Binding WybierzKlubCommand}"
            Padding="8,6"/>
            </Grid>

            <Label Grid.Column="0" Grid.Row="2" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Stanowisko"/>
            <ComboBox Grid.Column="1" Grid.Row="2"
                      Margin="0,6,0,6"
                      Padding="8,6"
                      Background="#223040"
                      Foreground="Black"
                      BorderBrush="#455A64"
                      ItemsSource="{Binding Stanowiska}"
                      SelectedValuePath="Id"
                      DisplayMemberPath="Nazwa"
                      SelectedValue="{Binding StanowiskoId, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="3" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Data od"/>
            <DatePicker Grid.Column="1" Grid.Row="3"
                        Margin="0,6,0,6"
                        SelectedDate="{Binding DataOd, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="4" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Data do"/>
            <DatePicker Grid.Column="1" Grid.Row="4"
                        Margin="0,6,0,6"
                        SelectedDate="{Binding DataDo, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="5" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Top" Content="Uwagi"/>
            <TextBox Grid.Column="1" Grid.Row="5"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Height="80"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Uwagi, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="6" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Aktywny"/>
            <CheckBox Grid.Column="1" Grid.Row="6"
                      Margin="0,10,0,6"
                      IsChecked="{Binding CzyAktywny}"/>
        </Grid>
    </Border>
</local:JedenViewBase>