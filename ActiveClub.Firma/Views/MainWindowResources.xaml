            Command="{Binding CloseCommand}"
            Content="X"
            Cursor="Hand"
            DockPanel.Dock="Right"
            Focusable="False"
            FontFamily="Courier"
            FontSize="9"
            FontWeight="Bold"
            Width="16"
            Height="16"
            Margin="4,0,0,0"
            Padding="0" />

            <ContentPresenter
            Content="{Binding DisplayName}"
            VerticalAlignment="Center" />
        </DockPanel>
    </DataTemplate>
