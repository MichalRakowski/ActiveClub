<local:WszystkieViewBase x:Class="ActiveClub.Firma.Views.WszystkieAktualnosciView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ActiveClub.Firma.Views"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="1000">

    <Border Background="#2D3E50"
            CornerRadius="8"
            Padding="8">

        <DataGrid ItemsSource="{Binding List}"
                  SelectedItem="{Binding WybranaAktualnosc}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  Background="#2D3E50"
                  Foreground="White"
                  BorderThickness="0"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  AlternationCount="2">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#455A64"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#223040"/>
                    <Setter Property="Padding" Value="8,6"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#223040"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>

                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#2C3E50"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2C3E50"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#455A64"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding AktualnoscId}"
                                    Width="70"/>

                <DataGridTextColumn Header="Tytuł"
                                    Binding="{Binding Tytul}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Klub ID"
                                    Binding="{Binding KlubId}"
                                    Width="100"/>

                <DataGridCheckBoxColumn Header="Widoczna"
                                        Binding="{Binding CzyWidoczna}"
                                        Width="100"/>

                <DataGridTextColumn Header="Data publikacji"
                                    Binding="{Binding DataPublikacji, StringFormat=yyyy-MM-dd}"
                                    Width="140"/>

                <DataGridTextColumn Header="Data dodania"
                                    Binding="{Binding DataDodania, StringFormat=yyyy-MM-dd HH:mm}"
                                    Width="160"/>

                <DataGridTextColumn Header="Treść"
                                    Binding="{Binding Tresc}"
                                    Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Border>
</local:WszystkieViewBase>