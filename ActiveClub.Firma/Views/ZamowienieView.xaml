<local:JedenViewBase x:Class="ActiveClub.Firma.Views.ZamowienieView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="clr-namespace:ActiveClub.Firma.Views"
                     mc:Ignorable="d"
                     d:DesignHeight="760"
                     d:DesignWidth="900">

    <local:JedenViewBase.Resources>
        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#455A64"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="Background" Value="White"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#223040"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#455A64"/>
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="Label">
            <Setter Property="Margin" Value="0,6,12,6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </local:JedenViewBase.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="#2D3E50" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0"
                       Style="{StaticResource FormLabelStyle}"
                       Content="Numer zamówienia"/>

                <TextBox Grid.Row="0" Grid.Column="1"
                         Margin="0,6,0,6"
                         Style="{StaticResource FormTextBoxStyle}"
                         Text="{Binding NumerZamowienia, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="1" Grid.Column="0"
                       Style="{StaticResource FormLabelStyle}"
                       Content="Użytkownik"/>

                <Grid Grid.Row="1" Grid.Column="1" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
             Margin="0,0,8,0"
             Style="{StaticResource FormTextBoxStyle}"
             IsReadOnly="True"
             Text="{Binding SelectedUzytkownikNazwa, Mode=OneWay}"/>

                    <Button Grid.Column="1"
            Content="Wybierz użytkownika"
            Command="{Binding WybierzUzytkownikaCommand}"
            Padding="8,6"/>
                </Grid>
                <Label Grid.Row="2" Grid.Column="0"
                       Style="{StaticResource FormLabelStyle}"
                       Content="Klub"/>

                <Grid Grid.Row="2" Grid.Column="1" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
             Margin="0,0,8,0"
             Style="{StaticResource FormTextBoxStyle}"
             IsReadOnly="True"
             Text="{Binding SelectedKlubNazwa, Mode=OneWay}"/>

                    <Button Grid.Column="1"
            Content="Wybierz klub"
            Command="{Binding WybierzKlubCommand}"
            Padding="8,6"/>
                </Grid>
                <Label Grid.Row="3" Grid.Column="0"
                       Style="{StaticResource FormLabelStyle}"
                       Content="Status"/>

                <TextBox Grid.Row="3" Grid.Column="1"
                         Margin="0,6,0,6"
                         Style="{StaticResource FormTextBoxStyle}"
                         Text="{Binding Status, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="4" Grid.Column="0"
                       Style="{StaticResource FormLabelStyle}"
                       Content="Suma brutto"/>

                <TextBox Grid.Row="4" Grid.Column="1"
                         Margin="0,6,0,6"
                         Style="{StaticResource FormTextBoxStyle}"
                         Text="{Binding SumaBrutto, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="5" Grid.Column="0"
                       Style="{StaticResource FormLabelStyle}"
                       Content="Kwota rabatu"/>

                <TextBox Grid.Row="5" Grid.Column="1"
                         Margin="0,6,0,6"
                         Style="{StaticResource FormTextBoxStyle}"
                         Text="{Binding KwotaRabatu, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="6" Grid.Column="0"
                       Style="{StaticResource FormLabelStyle}"
                       Content="Waluta"/>

                <TextBox Grid.Row="6" Grid.Column="1"
                         Margin="0,6,0,6"
                         Style="{StaticResource FormTextBoxStyle}"
                         Text="{Binding Waluta, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="7" Grid.Column="0"
                       Style="{StaticResource FormLabelStyle}"
                       Content="Metoda płatności"/>

                <ComboBox Grid.Row="7" Grid.Column="1"
                          Margin="0,6,0,6"
                          Style="{StaticResource FormComboBoxStyle}"
                          ItemsSource="{Binding MetodyPlatnosci}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Nazwa"
                          SelectedValue="{Binding MetodaPlatnosciId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="8" Grid.Column="0"
                       Style="{StaticResource FormLabelStyle}"
                       Content="Rabat"/>

                <ComboBox Grid.Row="8" Grid.Column="1"
                          Margin="0,6,0,6"
                          Style="{StaticResource FormComboBoxStyle}"
                          ItemsSource="{Binding Rabaty}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Nazwa"
                          SelectedValue="{Binding RabatId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <!--<Label Grid.Row="9" Grid.Column="0"
                       Style="{StaticResource FormLabelStyle}"
                       Content="Typ kanału"/>

                <TextBox Grid.Row="9" Grid.Column="1"
                         Margin="0,6,0,6"
                         Style="{StaticResource FormTextBoxStyle}"
                         Text="{Binding TypKanalu, UpdateSourceTrigger=PropertyChanged}"/>-->

                <Label Grid.Row="10" Grid.Column="0"
                       Style="{StaticResource FormLabelStyle}"
                       Content="Data utworzenia"/>

                <DatePicker Grid.Row="10" Grid.Column="1"
                            Margin="0,6,0,6"
                            SelectedDate="{Binding DataUtworzeniaDate, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="11" Grid.Column="0"
                       Style="{StaticResource FormLabelStyle}"
                       Content="Data opłacenia"/>

                <DatePicker Grid.Row="11" Grid.Column="1"
                            Margin="0,6,0,6"
                            SelectedDate="{Binding DataOplaceniaDate, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="12" Grid.Column="0"
                       Style="{StaticResource FormLabelStyle}"
                       Content="Utworzył użytkownik"/>

                <Grid Grid.Row="12" Grid.Column="1" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
             Margin="0,0,8,0"
             Style="{StaticResource FormTextBoxStyle}"
             IsReadOnly="True"
             Text="{Binding SelectedUtworzylUzytkownikNazwa, Mode=OneWay}"/>

                    <Button Grid.Column="1"
            Content="Wybierz użytkownika"
            Command="{Binding WybierzUtworzylUzytkownikaCommand}"
            Padding="8,6"/>
                </Grid>
            </Grid>
        </Border>
    </ScrollViewer>
</local:JedenViewBase>