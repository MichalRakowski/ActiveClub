<local:JedenViewBase x:Class="ActiveClub.Firma.Views.CzlonkostwoUzytkownikaView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="clr-namespace:ActiveClub.Firma.Views"
                     mc:Ignorable="d"
                     d:DesignHeight="760"
                     d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="#2D3E50" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Użytkownik"/>
                <Grid Grid.Row="0" Grid.Column="1" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
             Margin="0,0,8,0"
             Padding="8,6"
             Background="#223040"
             Foreground="White"
             BorderBrush="#455A64"
             IsReadOnly="True"
             Text="{Binding SelectedUzytkownikNazwa, Mode=OneWay}"/>

                    <Button Grid.Column="1"
            Content="Wybierz użytkownika"
            Command="{Binding WybierzUzytkownikaCommand}"
            Padding="8,6"/>
                </Grid>

                <!--<Label Grid.Row="1" Grid.Column="0" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Oferta klubu członkostwa"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,6"
                          ItemsSource="{Binding OfertyKlubuCzlonkostwa}"
                          DisplayMemberPath="Nazwa"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding OfertaKlubuCzlonkostwoId, UpdateSourceTrigger=PropertyChanged}"/>-->

                <Label Grid.Row="2" Grid.Column="0" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Rodzaj członkostwa"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,6"
                          ItemsSource="{Binding RodzajeCzlonkostwa}"
                          DisplayMemberPath="Nazwa"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding RodzajCzlonkostwaId, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="3" Grid.Column="0" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Klub"/>
                <Grid Grid.Row="3" Grid.Column="1" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
             Margin="0,0,8,0"
             Padding="8,6"
             Background="#223040"
             Foreground="White"
             BorderBrush="#455A64"
             IsReadOnly="True"
             Text="{Binding SelectedKlubNazwa, Mode=OneWay}"/>

                    <Button Grid.Column="1"
            Content="Wybierz klub"
            Command="{Binding WybierzKlubCommand}"
            Padding="8,6"/>
                </Grid>

                <Label Grid.Row="4" Grid.Column="0" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Data od"/>
                <DatePicker Grid.Row="4" Grid.Column="1" Margin="0,6,0,6"
                            SelectedDate="{Binding StartAt, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="5" Grid.Column="0" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Data do"/>
                <DatePicker Grid.Row="5" Grid.Column="1" Margin="0,6,0,6"
                            SelectedDate="{Binding EndAt, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="6" Grid.Column="0" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Status"/>
                <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,6,0,6"
                          ItemsSource="{Binding Statusy}"
                          DisplayMemberPath="Nazwa"
                          SelectedValuePath="Nazwa"
                          SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="7" Grid.Column="0" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Cena zakupu"/>
                <TextBox Grid.Row="7" Grid.Column="1" Margin="0,6,0,6" Padding="8,6"
                         Background="#223040" Foreground="White" BorderBrush="#455A64"
                         Text="{Binding CenaZakupu, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="8" Grid.Column="0" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Zamówienie"/>
                <ComboBox Grid.Row="8" Grid.Column="1" Margin="0,6,0,6"
                          ItemsSource="{Binding Zamowienia}"
                          DisplayMemberPath="Nazwa"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding ZamowienieId, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="9" Grid.Column="0" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Nadane przez"/>
                <ComboBox Grid.Row="9" Grid.Column="1" Margin="0,6,0,6"
                          ItemsSource="{Binding NadajacyUzytkownicy}"
                          DisplayMemberPath="Nazwa"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding NadanePrzezUzytkownikId, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="10" Grid.Column="0" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Data utworzenia"/>
                <DatePicker Grid.Row="10" Grid.Column="1" Margin="0,6,0,6"
                            SelectedDate="{Binding DataUtworzenia, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="11" Grid.Column="0" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Data aktywacji"/>
                <DatePicker Grid.Row="11" Grid.Column="1" Margin="0,6,0,6"
                            SelectedDate="{Binding DataAktywacji, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="12" Grid.Column="0" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Data anulowania"/>
                <DatePicker Grid.Row="12" Grid.Column="1" Margin="0,6,0,6"
                            SelectedDate="{Binding DataAnulowania, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="13" Grid.Column="0" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Powód anulowania"/>
                <TextBox Grid.Row="13" Grid.Column="1" Margin="0,6,0,6" Padding="8,6"
                         Background="#223040" Foreground="White" BorderBrush="#455A64"
                         Text="{Binding PowodAnulowania, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>
    </ScrollViewer>
</local:JedenViewBase>