<local:JedenViewBase x:Class="ActiveClub.Firma.Views.KlubyView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="clr-namespace:ActiveClub.Firma.Views"
                     mc:Ignorable="d"
                     d:DesignHeight="520"
                     d:DesignWidth="800">

    <Border Background="#2D3E50"
            CornerRadius="8"
            Padding="12">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Nazwa *"/>

            <TextBox Grid.Column="1" Grid.Row="0"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Nazwa, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="1"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Miasto"/>

            <TextBox Grid.Column="1" Grid.Row="1"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Miasto, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

            <Label Grid.Column="0" Grid.Row="2"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Ulica"/>

            <TextBox Grid.Column="1" Grid.Row="2"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Ulica, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

            <Label Grid.Column="0" Grid.Row="3"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Kod pocztowy"/>

            <TextBox Grid.Column="1" Grid.Row="3"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding KodPocztowy, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

            <Label Grid.Column="0" Grid.Row="4"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Telefon"/>

            <TextBox Grid.Column="1" Grid.Row="4"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Telefon, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

            <Label Grid.Column="0" Grid.Row="5"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Email kontakt"/>

            <TextBox Grid.Column="1" Grid.Row="5"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding EmailKontakt, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

            <Label Grid.Column="0" Grid.Row="6"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Czy aktywny"/>

            <CheckBox Grid.Column="1" Grid.Row="6"
                      Margin="0,6,0,6"
                      Foreground="White"
                      VerticalAlignment="Center"
                      IsChecked="{Binding CzyAktywny, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="7"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Data utworzenia"/>

            <TextBox Grid.Column="1" Grid.Row="7"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     IsReadOnly="True"
                     Text="{Binding DataUtworzenia, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>

            <Label Grid.Column="0" Grid.Row="8"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Top"
                   Content="Opis"/>

            <TextBox Grid.Column="1" Grid.Row="8"
                     Margin="0,6,0,0"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Opis, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="120"
                     VerticalAlignment="Stretch"
                     VerticalScrollBarVisibility="Auto"/>
        </Grid>
    </Border>
</local:JedenViewBase>