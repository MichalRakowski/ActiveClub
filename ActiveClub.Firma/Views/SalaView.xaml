<local:JedenViewBase x:Class="ActiveClub.Firma.Views.SalaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ActiveClub.Firma.Views"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="800">

    <Border Background="#2D3E50"
            CornerRadius="8"
            Padding="12">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Klub"/>

            <Grid Grid.Column="1" Grid.Row="0" Margin="0,6,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Margin="0,0,8,0"
                         Padding="8,6"
                         Background="#223040"
                         Foreground="White"
                         BorderBrush="#455A64"
                         IsReadOnly="True"
                         Text="{Binding SelectedKlubNazwa, Mode=OneWay}"/>

                <Button Grid.Column="1"
                        Content="Wybierz klub"
                        Command="{Binding WybierzKlubCommand}"
                        Padding="8,6"/>
            </Grid>

            <Label Grid.Column="0" Grid.Row="1"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Nazwa"/>

            <TextBox Grid.Column="1" Grid.Row="1"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Nazwa, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="2"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Pojemność"/>

            <TextBox Grid.Column="1" Grid.Row="2"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding PojemnoscText, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="3"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Aktywna"/>

            <CheckBox Grid.Column="1" Grid.Row="3"
                      Margin="0,10,0,6"
                      IsChecked="{Binding CzyAktywna}"/>

            <Label Grid.Column="0" Grid.Row="4"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Top"
                   Content="Opis"/>

            <TextBox Grid.Column="1" Grid.Row="4"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Height="120"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Text="{Binding Opis, UpdateSourceTrigger=PropertyChanged}"/>

           
        </Grid>
    </Border>
</local:JedenViewBase>