<local:JedenViewBase x:Class="ActiveClub.Firma.Views.UzytkownicyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ActiveClub.Firma.Views"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="800">

    <local:JedenViewBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </local:JedenViewBase.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="#2D3E50"
                CornerRadius="8"
                Padding="12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Grid.Row="0" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Center"
                       Content="Rola"/>

                <ComboBox Grid.Column="1" Grid.Row="0" Margin="0,6,0,6" Padding="8,6"
                          Background="#223040" Foreground="Black" BorderBrush="#455A64"
                          ItemsSource="{Binding AvailableRoles}"
                          SelectedItem="{Binding SelectedRola}"/>

                <Label Grid.Column="0" Grid.Row="1" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Center"
                       Content="Imię"/>

                <TextBox Grid.Column="1" Grid.Row="1" Margin="0,6,0,6" Padding="8,6"
                         Background="#223040" Foreground="White" BorderBrush="#455A64"
                         Text="{Binding Imie, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Column="0" Grid.Row="2" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Center"
                       Content="Nazwisko"/>

                <TextBox Grid.Column="1" Grid.Row="2" Margin="0,6,0,6" Padding="8,6"
                         Background="#223040" Foreground="White" BorderBrush="#455A64"
                         Text="{Binding Nazwisko, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Column="0" Grid.Row="3" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Center"
                       Content="Email"/>

                <TextBox Grid.Column="1" Grid.Row="3" Margin="0,6,0,6" Padding="8,6"
                         Background="#223040" Foreground="White" BorderBrush="#455A64"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Column="0" Grid.Row="4" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Center"
                       Content="Telefon"/>

                <TextBox Grid.Column="1" Grid.Row="4" Margin="0,6,0,6" Padding="8,6"
                         Background="#223040" Foreground="White" BorderBrush="#455A64"
                         Text="{Binding Telefon, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Column="0" Grid.Row="5" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Center"
                       Content="Hasło"
                       Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <TextBox Grid.Column="1" Grid.Row="5" Margin="0,6,0,6" Padding="8,6"
                         Background="#223040" Foreground="White" BorderBrush="#455A64"
                         Text="{Binding Haslo, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Label Grid.Column="0" Grid.Row="6" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Center"
                       Content="Aktywny"/>

                <CheckBox Grid.Column="1" Grid.Row="6" Margin="0,10,0,6"
                          IsChecked="{Binding CzyAktywny}"/>

                <Label Grid.Column="0" Grid.Row="7" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Center"
                       Content="Klub"
                       Visibility="{Binding RequiresEmployeeData, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Grid Grid.Column="1" Grid.Row="7" Margin="0,6,0,6"
                      Visibility="{Binding RequiresEmployeeData, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Margin="0,0,8,0" Padding="8,6"
                             Background="#223040" Foreground="White" BorderBrush="#455A64"
                             IsReadOnly="True"
                             Text="{Binding SelectedKlubNazwa, Mode=OneWay}"/>

                    <Button Grid.Column="1"
                            Content="Wybierz klub"
                            Command="{Binding WybierzKlubCommand}"
                            Padding="8,6"/>
                </Grid>

                <Label Grid.Column="0" Grid.Row="8" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Center"
                       Content="Stanowisko"
                       Visibility="{Binding RequiresEmployeeData, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <ComboBox Grid.Column="1" Grid.Row="8"
                          Margin="0,6,0,6"
                          Padding="8,6"
                          Background="#223040"
                          Foreground="Black"
                          BorderBrush="#455A64"
                          ItemsSource="{Binding Stanowiska}"
                          DisplayMemberPath="Nazwa"
                          SelectedValuePath="StanowiskoId"
                          SelectedValue="{Binding StanowiskoId, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding RequiresEmployeeData, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Label Grid.Column="0" Grid.Row="9" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Center"
                       Content="Trener"
                       Visibility="{Binding RequiresEmployeeData, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Grid Grid.Column="1" Grid.Row="9" Margin="0,6,0,6"
                      Visibility="{Binding RequiresEmployeeData, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Margin="0,0,8,0" Padding="8,6"
                             Background="#223040" Foreground="White" BorderBrush="#455A64"
                             IsReadOnly="True"
                             Text="{Binding SelectedTrenerNazwa, Mode=OneWay}"/>

                    <Button Grid.Column="1"
                            Content="Wybierz trenera"
                            Command="{Binding WybierzTreneraCommand}"
                            Padding="8,6"/>
                </Grid>

                <Label Grid.Column="0" Grid.Row="10" Margin="0,6,12,6"
       Foreground="White" VerticalAlignment="Center"
       Content="Harmonogram"
       Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Grid Grid.Column="1" Grid.Row="10" Margin="0,6,0,6"
      Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Margin="0,0,8,0" Padding="8,6"
             Background="#223040" Foreground="White" BorderBrush="#455A64"
             IsReadOnly="True"
             Text="{Binding SelectedHarmonogramNazwa, Mode=OneWay}"/>

                    <Button Grid.Column="1"
            Content="Zmień harmonogram"
            Command="{Binding WybierzHarmonogramCommand}"
            Padding="8,6"/>
                </Grid>

                <Label Grid.Column="0" Grid.Row="11" Margin="0,6,12,6"
       Foreground="White" VerticalAlignment="Center"
       Content="Członkostwo / Karnet"
       Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <ComboBox Grid.Column="1" Grid.Row="11"
          Margin="0,6,0,6"
          Padding="8,6"
          Background="#223040"
          Foreground="Black"
          BorderBrush="#455A64"
          ItemsSource="{Binding Czlonkostwa}"
          DisplayMemberPath="Nazwa"
          SelectedValuePath="Id"
          SelectedValue="{Binding SelectedCzlonkostwoId, UpdateSourceTrigger=PropertyChanged}"
          Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Label Grid.Column="0" Grid.Row="12" Margin="0,6,12,6"
       Foreground="White" VerticalAlignment="Center"
       Content="Zamówienia"
       Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Grid Grid.Column="1" Grid.Row="12" Margin="0,6,0,6"
      Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Margin="0,0,8,0" Padding="8,6"
             Background="#223040" Foreground="White" BorderBrush="#455A64"
             IsReadOnly="True"
             Text="{Binding ZamowieniaPodsumowanie, Mode=OneWay}"/>

                    <Button Grid.Column="1"
            Content="Pokaż historię"
            Command="{Binding PokazHistorieZamowienCommand}"
            Padding="8,6"/>
                </Grid>

                <Label Grid.Column="0" Grid.Row="13" Margin="0,6,12,6"
       Foreground="White" VerticalAlignment="Center"
       Content="Płatności"
       Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Grid Grid.Column="1" Grid.Row="13" Margin="0,6,0,6"
      Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Margin="0,0,8,0" Padding="8,6"
             Background="#223040" Foreground="White" BorderBrush="#455A64"
             IsReadOnly="True"
             Text="{Binding PlatnosciPodsumowanie, Mode=OneWay}"/>

                    <Button Grid.Column="1"
            Content="Pokaż historię"
            Command="{Binding PokazHistoriePlatnosciCommand}"
            Padding="8,6"/>
                </Grid>

                <Label Grid.Column="0" Grid.Row="14" Margin="0,6,12,6"
                       Foreground="White" VerticalAlignment="Top"
                       Content="Uwagi"/>

                <TextBox Grid.Column="1" Grid.Row="14" Margin="0,6,0,6" Padding="8,6"
                         Height="90"
                         Background="#223040" Foreground="White" BorderBrush="#455A64"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Text="{Binding Uwagi, UpdateSourceTrigger=PropertyChanged}"/>

               
            </Grid>
        </Border>
    </ScrollViewer>
</local:JedenViewBase>