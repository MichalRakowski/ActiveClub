<local:JedenViewBase x:Class="ActiveClub.Firma.Views.AktualnosciView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ActiveClub.Firma.Views"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="900">

    <Border Background="#2D3E50" CornerRadius="8" Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Margin="0,6,12,6"
                   Foreground="White" Content="Data dodania"/>

            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,6,0,6" Padding="8,6"
                     Background="#223040" Foreground="White" BorderBrush="#455A64"
                     IsReadOnly="True"
                     Text="{Binding DataDodania, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm:ss}"/>

            <Label Grid.Row="1" Grid.Column="0" Margin="0,6,12,6"
                   Foreground="White" Content="Data publikacji"/>

            <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,6,0,6"
                        SelectedDate="{Binding DataPublikacji, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="2" Grid.Column="0" Margin="0,6,12,6"
                   Foreground="White" Content="Tytuł"/>

            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,6" Padding="8,6"
                     Background="#223040" Foreground="White" BorderBrush="#455A64"
                     Text="{Binding Tytul, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="3" Grid.Column="0" Margin="0,6,12,6"
                   Foreground="White" Content="Klub"/>

            <Grid Grid.Row="3" Grid.Column="1" Margin="0,6,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Margin="0,0,8,0" Padding="8,6"
                         Background="#223040" Foreground="White" BorderBrush="#455A64"
                         IsReadOnly="True"
                         Text="{Binding SelectedKlubNazwa, Mode=OneWay}"/>

                <Button Grid.Column="1"
                        Content="Wybierz klub"
                        Command="{Binding WybierzKlubCommand}"
                        Padding="8,6"/>
            </Grid>

            <Label Grid.Row="4" Grid.Column="0" Margin="0,6,12,6"
                   Foreground="White" Content="Dodane przez"/>

            <Grid Grid.Row="4" Grid.Column="1" Margin="0,6,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Margin="0,0,8,0" Padding="8,6"
                         Background="#223040" Foreground="White" BorderBrush="#455A64"
                         IsReadOnly="True"
                         Text="{Binding SelectedUzytkownikNazwa, Mode=OneWay}"/>

                <Button Grid.Column="1"
                        Content="Wybierz użytkownika"
                        Command="{Binding WybierzUzytkownikaCommand}"
                        Padding="8,6"/>
            </Grid>

            <Label Grid.Row="5" Grid.Column="0" Margin="0,6,12,6"
                   Foreground="White" Content="Czy widoczna"/>

            <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,6,0,6"
                      Foreground="White"
                      IsChecked="{Binding CzyWidoczna, UpdateSourceTrigger=PropertyChanged}"
                      Content="Widoczna"/>

            <Label Grid.Row="6" Grid.Column="0" Margin="0,6,12,6"
                   Foreground="White" VerticalAlignment="Top" Content="Treść"/>

            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,6,0,6" Padding="8,6"
                     Background="#223040" Foreground="White" BorderBrush="#455A64"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="200"
                     Text="{Binding Tresc, UpdateSourceTrigger=PropertyChanged}"/>

           
        </Grid>
    </Border>
</local:JedenViewBase>