<local:JedenViewBase x:Class="ActiveClub.Firma.Views.UstawieniaKontaktoweView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="clr-namespace:ActiveClub.Firma.Views"
                     mc:Ignorable="d"
                     d:DesignHeight="700"
                     d:DesignWidth="900">

    <Border Background="#2D3E50" CornerRadius="8" Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0"
                   Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Email"/>

            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="1"
                   Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Telefon"/>

            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Telefon, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="2"
                   Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Top"
                   Content="Adres"/>

            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Height="90"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Adres, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="3"
                   Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Godziny kontaktu"/>

            <TextBox Grid.Row="3"
                     Grid.Column="1"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding GodzinyKontaktu, UpdateSourceTrigger=PropertyChanged}"/>

           
        </Grid>
    </Border>
</local:JedenViewBase>