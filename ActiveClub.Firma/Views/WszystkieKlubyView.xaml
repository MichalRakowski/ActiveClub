<local:WszystkieViewBase x:Class="ActiveClub.Firma.Views.WszystkieKlubyView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:local="clr-namespace:ActiveClub.Firma.Views"
                         mc:Ignorable="d"
                         d:DesignHeight="450"
                         d:DesignWidth="900">

    <Border Background="#2D3E50"
            CornerRadius="8"
            Padding="8">

        <DataGrid ItemsSource="{Binding List}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  Background="#2D3E50"
                  Foreground="White"
                  BorderThickness="0"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  AlternationCount="2"
                  RowHeaderWidth="0">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#455A64"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#223040"/>
                    <Setter Property="Padding" Value="8,6"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis"/>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#223040"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>

                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#2C3E50"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#355066"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#455A64"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nazwa"
                                    Binding="{Binding Nazwa, TargetNullValue=''}"
                                    Width="180"/>

                <DataGridTextColumn Header="Miasto"
                                    Binding="{Binding Miasto, TargetNullValue=''}"
                                    Width="120"/>

                <DataGridTextColumn Header="Ulica"
                                    Binding="{Binding Ulica, TargetNullValue=''}"
                                    Width="180"/>

                <DataGridTextColumn Header="Kod pocztowy"
                                    Binding="{Binding KodPocztowy, TargetNullValue=''}"
                                    Width="110"/>

                <DataGridTextColumn Header="Telefon"
                                    Binding="{Binding Telefon, TargetNullValue=''}"
                                    Width="120"/>

                <DataGridTextColumn Header="Email kontakt"
                                    Binding="{Binding EmailKontakt, TargetNullValue=''}"
                                    Width="200"/>

                <DataGridCheckBoxColumn Header="Aktywny"
                                        Binding="{Binding CzyAktywny}"
                                        Width="80"/>

                <DataGridTextColumn Header="Data utworzenia"
                                    Binding="{Binding DataUtworzenia, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                    Width="150"/>

                <DataGridTextColumn Header="Opis"
                                    Binding="{Binding Opis, TargetNullValue=''}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Border>
</local:WszystkieViewBase>