<local:JedenViewBase x:Class="ActiveClub.Firma.Views.PlatnoscView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="clr-namespace:ActiveClub.Firma.Views"
                     mc:Ignorable="d"
                     d:DesignHeight="700"
                     d:DesignWidth="900">

    <Border Background="#2D3E50" CornerRadius="8" Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0"
                   Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Zamówienie"/>

            <ComboBox Grid.Row="0"
                      Grid.Column="1"
                      Margin="0,6,0,6"
                      Padding="6"
                      Background="White"
                      Foreground="Black"
                      BorderBrush="#455A64"
                      ItemsSource="{Binding Zamowienia}"
                      DisplayMemberPath="Nazwa"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedZamowienieId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="Background" Value="White"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>

            <Label Grid.Row="1"
                   Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Metoda płatności"/>

            <ComboBox Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,6,0,6"
                      Padding="6"
                      Background="White"
                      Foreground="Black"
                      BorderBrush="#455A64"
                      ItemsSource="{Binding MetodyPlatnosci}"
                      DisplayMemberPath="Nazwa"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedMetodaPlatnosciId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="Background" Value="White"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>

            <Label Grid.Row="2"
                   Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Kwota"/>

            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Kwota, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="3"
                   Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Waluta"/>

            <ComboBox Grid.Row="3"
                      Grid.Column="1"
                      Margin="0,6,0,6"
                      Padding="6"
                      Background="White"
                      Foreground="Black"
                      BorderBrush="#455A64"
                      ItemsSource="{Binding Waluty}"
                      SelectedItem="{Binding SelectedWaluta, Mode=TwoWay}"
                      DisplayMemberPath="Nazwa">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="Background" Value="White"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>

            <Label Grid.Row="4"
                   Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Status"/>

            <ComboBox Grid.Row="4"
                      Grid.Column="1"
                      Margin="0,6,0,6"
                      Padding="6"
                      Background="White"
                      Foreground="Black"
                      BorderBrush="#455A64"
                      ItemsSource="{Binding Statusy}"
                      SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                      DisplayMemberPath="Nazwa">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="Background" Value="White"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>

            <!--<Label Grid.Row="5"
                   Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Provider"/>

            <TextBox Grid.Row="5"
                     Grid.Column="1"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Provider, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="6"
                   Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Provider Transaction ID"/>

            <TextBox Grid.Row="6"
                     Grid.Column="1"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding ProviderTransactionId, UpdateSourceTrigger=PropertyChanged}"/>-->

            <Label Grid.Row="7"
                   Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Data płatności"/>

            <DatePicker Grid.Row="7"
                        Grid.Column="1"
                        Margin="0,6,0,6"
                        SelectedDate="{Binding DataPlatnosci, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="8"
                   Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Content="Data utworzenia"/>

            <DatePicker Grid.Row="8"
                        Grid.Column="1"
                        Margin="0,6,0,6"
                        SelectedDate="{Binding DataUtworzenia, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Row="9"
                   Grid.Column="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Top"
                   Content="Uwagi"/>

            <TextBox Grid.Row="9"
                     Grid.Column="1"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Height="80"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Uwagi, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
    </Border>
</local:JedenViewBase>