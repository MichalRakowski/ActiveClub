<local:JedenViewBase x:Class="ActiveClub.Firma.Views.HarmonogramZajecView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="clr-namespace:ActiveClub.Firma.Views"
                     mc:Ignorable="d"
                     d:DesignHeight="760"
                     d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="#2D3E50" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.Resources>
                    <Style x:Key="CzarnyComboBoxStyle" TargetType="ComboBox">
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#455A64"/>
                        <Setter Property="Padding" Value="6"/>
                    </Style>

                    <Style x:Key="CzarnyComboBoxItemStyle" TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="Background" Value="White"/>
                    </Style>
                </Grid.Resources>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Grid.Row="0" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Klub"/>
                <Grid Grid.Column="1" Grid.Row="0" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Margin="0,0,8,0"
                             Padding="8,6"
                             Background="#223040"
                             Foreground="White"
                             BorderBrush="#455A64"
                             IsReadOnly="True"
                             Text="{Binding SelectedKlubNazwa, Mode=OneWay}"/>

                    <Button Grid.Column="1"
                            Content="Wybierz klub"
                            Command="{Binding WybierzKlubCommand}"
                            Padding="8,6"/>
                </Grid>

                <Label Grid.Column="0" Grid.Row="1" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Rodzaj zajęć"/>
                <ComboBox Grid.Column="1" Grid.Row="1"
                          Margin="0,6,0,6"
                          Style="{StaticResource CzarnyComboBoxStyle}"
                          ItemContainerStyle="{StaticResource CzarnyComboBoxItemStyle}"
                          ItemsSource="{Binding RodzajeZajec}"
                          SelectedItem="{Binding SelectedRodzajZajec, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="Nazwa"/>

                <Label Grid.Column="0" Grid.Row="2" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Sala"/>
                <ComboBox Grid.Column="1" Grid.Row="2"
                          Margin="0,6,0,6"
                          Style="{StaticResource CzarnyComboBoxStyle}"
                          ItemContainerStyle="{StaticResource CzarnyComboBoxItemStyle}"
                          ItemsSource="{Binding Sale}"
                          SelectedItem="{Binding SelectedSala, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="Nazwa"/>

                <Label Grid.Column="0" Grid.Row="3" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Trener"/>
                <Grid Grid.Column="1" Grid.Row="3" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Margin="0,0,8,0"
                             Padding="8,6"
                             Background="#223040"
                             Foreground="White"
                             BorderBrush="#455A64"
                             IsReadOnly="True"
                             Text="{Binding SelectedTrenerNazwa, Mode=OneWay}"/>

                    <Button Grid.Column="1"
                            Content="Wybierz trenera"
                            Command="{Binding WybierzTreneraCommand}"
                            Padding="8,6"/>
                </Grid>

                <Label Grid.Column="0" Grid.Row="4" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Data od"/>
                <DatePicker Grid.Column="1" Grid.Row="4"
                            Margin="0,6,0,6"
                            SelectedDate="{Binding DataOd, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Column="0" Grid.Row="5" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Data do"/>
                <DatePicker Grid.Column="1" Grid.Row="5"
                            Margin="0,6,0,6"
                            SelectedDate="{Binding DataDo, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Column="0" Grid.Row="6" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Godzina"/>
                <StackPanel Grid.Column="1" Grid.Row="6" Orientation="Horizontal" Margin="0,6,0,6">
                    <TextBox Width="90"
                             Margin="0,0,8,0"
                             Padding="8,6"
                             Background="#223040"
                             Foreground="White"
                             BorderBrush="#455A64"
                             Text="{Binding GodzinaStart, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="do"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <TextBox Width="90"
                             Padding="8,6"
                             Background="#223040"
                             Foreground="White"
                             BorderBrush="#455A64"
                             Text="{Binding GodzinaKoniec, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Label Grid.Column="0" Grid.Row="7" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Dni tygodnia"/>
                <StackPanel Grid.Column="1" Grid.Row="7" Orientation="Horizontal" Margin="0,6,0,6">
                    <CheckBox Content="Pon" Foreground="White" IsChecked="{Binding Pon}" Margin="0,0,8,0"/>
                    <CheckBox Content="Wt" Foreground="White" IsChecked="{Binding Wt}" Margin="0,0,8,0"/>
                    <CheckBox Content="Śr" Foreground="White" IsChecked="{Binding Sr}" Margin="0,0,8,0"/>
                    <CheckBox Content="Czw" Foreground="White" IsChecked="{Binding Czw}" Margin="0,0,8,0"/>
                    <CheckBox Content="Pt" Foreground="White" IsChecked="{Binding Pt}" Margin="0,0,8,0"/>
                    <CheckBox Content="Sob" Foreground="White" IsChecked="{Binding Sob}" Margin="0,0,8,0"/>
                    <CheckBox Content="Nd" Foreground="White" IsChecked="{Binding Nd}"/>
                </StackPanel>

                <Label Grid.Column="0" Grid.Row="8" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Limit miejsc"/>
                <TextBox Grid.Column="1" Grid.Row="8"
                         Margin="0,6,0,6"
                         Padding="8,6"
                         Background="#223040"
                         Foreground="White"
                         BorderBrush="#455A64"
                         Text="{Binding LimitMiejsc, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Column="0" Grid.Row="9"
       Margin="0,6,12,6"
       Foreground="White"
       VerticalAlignment="Center"
       Content="Status"/>

                <ComboBox Grid.Column="1"
          Grid.Row="9"
          Margin="0,6,0,6"
          Style="{StaticResource CzarnyComboBoxStyle}"
          ItemContainerStyle="{StaticResource CzarnyComboBoxItemStyle}"
          ItemsSource="{Binding Statusy}"
          SelectedItem="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Column="0" Grid.Row="10" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Widoczne online"/>
                <CheckBox Grid.Column="1" Grid.Row="10"
                          Margin="0,10,0,6"
                          IsChecked="{Binding CzyWidoczneOnline}"/>

                <Label Grid.Column="0" Grid.Row="11" Margin="0,6,12,6" Foreground="White" VerticalAlignment="Center" Content="Utworzył użytkownik"/>
                <Grid Grid.Column="1" Grid.Row="11" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Margin="0,0,8,0"
                             Padding="8,6"
                             Background="#223040"
                             Foreground="White"
                             BorderBrush="#455A64"
                             IsReadOnly="True"
                             Text="{Binding SelectedUtworzylUzytkownikNazwa, Mode=OneWay}"/>

                    <Button Grid.Column="1"
                            Content="Wybierz użytkownika"
                            Command="{Binding WybierzUtworzylUzytkownikaCommand}"
                            Padding="8,6"/>
                </Grid>
            </Grid>
        </Border>
    </ScrollViewer>
</local:JedenViewBase>