<local:JedenViewBase x:Class="ActiveClub.Firma.Views.OfertaKlubuCzlonkostwoView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="clr-namespace:ActiveClub.Firma.Views"
                     mc:Ignorable="d"
                     d:DesignHeight="700"
                     d:DesignWidth="900">

    <Border Background="#2D3E50" CornerRadius="8" Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0"
                   Margin="0,6,12,6"
                   Foreground="White"
                   Content="Klub"/>

            <Grid Grid.Column="1" Grid.Row="0" Margin="0,6,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Margin="0,0,8,0"
                         Padding="8,6"
                         Background="#223040"
                         Foreground="White"
                         BorderBrush="#455A64"
                         IsReadOnly="True"
                         Text="{Binding SelectedKlubNazwa, Mode=OneWay}"/>

                <Button Grid.Column="1"
                        Content="Wybierz klub"
                        Command="{Binding WybierzKlubCommand}"
                        Padding="8,6"/>
            </Grid>

            <!--<Label Grid.Column="0" Grid.Row="1"
                   Margin="0,6,12,6"
                   Foreground="White"
                   Content="Rodzaj członkostwa"/>

            <ComboBox Grid.Column="1" Grid.Row="1"
                      Margin="0,6,0,6"
                      Padding="8,6"
                      Background="#223040"
                      Foreground="Black"
                      BorderBrush="#455A64"
                      ItemsSource="{Binding RodzajeCzlonkostwa}"
                      DisplayMemberPath="Nazwa"
                      SelectedItem="{Binding SelectedRodzajCzlonkostwa, UpdateSourceTrigger=PropertyChanged}"/>-->

            <Label Grid.Column="0" Grid.Row="2" Margin="0,6,12,6"
                   Foreground="White"
                   Content="Cena"/>

            <TextBox Grid.Column="1" Grid.Row="2"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Cena, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="3" Margin="0,6,12,6"
                   Foreground="White"
                   Content="Waluta"/>

            <TextBox Grid.Column="1" Grid.Row="3"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Waluta, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="4" Margin="0,6,12,6"
                   Foreground="White"
                   Content="Aktywna"/>

            <CheckBox Grid.Column="1" Grid.Row="4"
                      Margin="0,10,0,6"
                      IsChecked="{Binding CzyAktywna}"/>

            <Label Grid.Column="0" Grid.Row="5" Margin="0,6,12,6"
                   Foreground="White"
                   Content="Widoczne online"/>

            <CheckBox Grid.Column="1" Grid.Row="5"
                      Margin="0,10,0,6"
                      IsChecked="{Binding CzyWidoczneOnline}"/>

            <Label Grid.Column="0" Grid.Row="6" Margin="0,6,12,6"
                   Foreground="White"
                   Content="Data od"/>

            <DatePicker Grid.Column="1" Grid.Row="6"
                        Margin="0,6,0,6"
                        SelectedDate="{Binding DataOd, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="7" Margin="0,6,12,6"
                   Foreground="White"
                   Content="Data do"/>

            <DatePicker Grid.Column="1" Grid.Row="7"
                        Margin="0,6,0,6"
                        SelectedDate="{Binding DataDo, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="8" Margin="0,6,12,6"
                   Foreground="White"
                   Content="Kolejność"/>

            <TextBox Grid.Column="1" Grid.Row="8"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding Kolejnosc, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="0" Grid.Row="9" Margin="0,6,12,6"
                   Foreground="White"
                   VerticalAlignment="Top"
                   Content="Opis marketingowy"/>

            <TextBox Grid.Column="1" Grid.Row="9"
                     Margin="0,6,0,6"
                     Padding="8,6"
                     Height="100"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="#223040"
                     Foreground="White"
                     BorderBrush="#455A64"
                     Text="{Binding OpisMarketingowy, UpdateSourceTrigger=PropertyChanged}"/>

           
        </Grid>
    </Border>
</local:JedenViewBase>