<local:WszystkieViewBase x:Class="ActiveClub.Firma.Views.WszystkieGodzinyOtwarciaView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:local="clr-namespace:ActiveClub.Firma.Views"
                         mc:Ignorable="d"
                         d:DesignHeight="520"
                         d:DesignWidth="900">

    <Border Background="#2D3E50" CornerRadius="8" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding List}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowBackground="#223040"
                      AlternatingRowBackground="#263746"
                      Background="#223040"
                      Foreground="White"
                      BorderBrush="#455A64"
                      RowHeaderWidth="0">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1B2836"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="#455A64"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="8,6"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="6"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding GodzinyOtwarciaId}"
                                        Width="70"/>

                    <DataGridTextColumn Header="Klub ID"
                                        Binding="{Binding KlubId}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Dzień"
                                        Binding="{Binding DzienTygodnia}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Godzina od"
                                        Binding="{Binding GodzinaOd}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Godzina do"
                                        Binding="{Binding GodzinaDo}"
                                        Width="120"/>

                    <DataGridCheckBoxColumn Header="Zamknięte"
                                            Binding="{Binding CzyZamkniete}"
                                            Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</local:WszystkieViewBase>